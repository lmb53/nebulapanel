#!/usr/bin/env bash
#
# nebula-helper — the ONLY privileged surface of Nebula Panel.
# Installed root-owned to /usr/local/bin/nebula-helper with a single sudoers
# rule (nebula-panel ALL=(root) NOPASSWD: /usr/local/bin/nebula-helper *).
#
# It performs a fixed, validated set of operations so the panel never needs a
# broad `tee`/`ln`/`mkdir`/`certbot` sudo grant. Every argument is validated
# here before use. Keep this file root-owned and NOT writable by the web user.
#
set -euo pipefail

NGINX_AV=/etc/nginx/sites-available
NGINX_EN=/etc/nginx/sites-enabled
FM_ROOT_FILE=/etc/nebula-panel/fm-root
PANEL_ROOT_FILE=/etc/nebula-panel/panel-root
PUBLIC_IP_FILE=/etc/nebula-panel/public-ip
SITES_ROOT=/srv/nebula/sites
SITES_STATE=/etc/nebula-panel/sites
SITES_TRASH=/srv/nebula/trash
FILE_TRASH=/var/lib/nebula-panel/file-trash
BIND_ZONE_DIR=/etc/bind/nebula-zones
BIND_ZONE_CONF=/etc/bind/nebula-zones.conf
MODSEC_DIR=/etc/nginx/modsec
MODSEC_MAIN="$MODSEC_DIR/main.conf"
MODSEC_CONF="$MODSEC_DIR/modsecurity.conf"
MODSEC_ENABLE=/etc/nginx/conf.d/nebula-modsecurity.conf
MODSEC_AUDIT=/var/log/nginx/modsec_audit.log
MAIL_DIR=/etc/nebula-mail
MAIL_STORE=/var/mail/nebula
MAIL_VUID="$(id -u vmail 2>/dev/null || printf '5000')"
MAIL_VGID="$(id -g vmail 2>/dev/null || printf '5000')"
DKIM_DIR="$MAIL_DIR/dkim"

die() { echo "$*" >&2; exit 2; }

# Decode a Base64 argument without ever storing untrusted binary data in a
# Bash variable. Command substitution silently removes NUL bytes, so checking
# a variable against $'\0' rejects every payload while still failing to detect
# the original byte reliably. Decode to a file, cap it, and compare it with a
# NUL-stripped copy instead.
decode_payload_file() {
  local encoded="$1" target="$2" max_bytes="$3" stripped
  [[ "$encoded" =~ ^[A-Za-z0-9+/=]+$ ]] || return 1
  printf '%s' "$encoded" | base64 -d > "$target" 2>/dev/null || return 1
  [[ "$(stat -c %s "$target" 2>/dev/null || printf '%s' 999999999)" -le "$max_bytes" ]] || return 1
  stripped="$(mktemp)"
  tr -d '\000' < "$target" > "$stripped"
  if ! cmp -s "$target" "$stripped"; then
    rm -f "$stripped"
    return 1
  fi
  rm -f "$stripped"
}

broker_request_allowed() {
  local request="$1"
  if [[ "$request" =~ ^(DEBIAN_FRONTEND=noninteractive[[:space:]]+)?apt-get[[:space:]]+-o[[:space:]]+Dpkg::Use-Pty=0[[:space:]]+-o[[:space:]]+APT::Color=0[[:space:]]+(update|-y[[:space:]]+upgrade|install[[:space:]]+-y[[:space:]]+\'?[A-Za-z0-9+.-]+\'?|remove[[:space:]]+-y[[:space:]]+\'?[A-Za-z0-9+.-]+\'?|install[[:space:]]+--only-upgrade[[:space:]]+-y[[:space:]]+\'?[A-Za-z0-9+.-]+\'?)$ ]]; then
    printf '%s\n' apt
    return 0
  fi
  if [[ "$request" =~ ^ufw[[:space:]]+(status[[:space:]]+numbered|--force[[:space:]]+delete[[:space:]]+[1-9][0-9]*|--force[[:space:]]+enable|disable|(allow|deny|reject)[[:space:]]+\'?[A-Za-z0-9/-]{1,48}\'?)$ ]]; then
    printf '%s\n' ufw
    return 0
  fi
  return 1
}

# Older Nebula releases included Debian's Apache-only owasp-crs.load file from
# Nginx. Its IncludeOptional directives make every later package operation
# noisy and can stop Nginx reloads. Repair only that exact legacy signature.
repair_legacy_modsecurity_loader() {
  local setup="" candidate tmp backup
  [[ -f "$MODSEC_MAIN" ]] || return 0
  grep -Fq 'Include /usr/share/modsecurity-crs/owasp-crs.load' "$MODSEC_MAIN" || return 0
  for candidate in /etc/modsecurity/crs/crs-setup.conf \
                   /usr/share/modsecurity-crs/crs-setup.conf; do
    [[ -f "$candidate" ]] && { setup="$candidate"; break; }
  done
  [[ -n "$setup" && -d /usr/share/modsecurity-crs/rules && -f "$MODSEC_CONF" ]] \
    || { echo "cannot repair the legacy ModSecurity loader: OWASP CRS files are incomplete" >&2; return 1; }
  tmp="$(mktemp)"
  backup="$MODSEC_MAIN.nebula-legacy-bak"
  cp "$MODSEC_MAIN" "$backup"
  {
    echo "# Managed by Nebula Panel - ModSecurity rule entrypoint."
    echo "Include $MODSEC_CONF"
    echo "Include $setup"
    [[ -f /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf ]] \
      && echo "Include /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf"
    echo "Include /usr/share/modsecurity-crs/rules/*.conf"
    [[ -f /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf ]] \
      && echo "Include /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf"
  } > "$tmp"
  install -m 0644 -o root -g root "$tmp" "$MODSEC_MAIN"
  rm -f "$tmp"
  if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
    mv "$backup" "$MODSEC_MAIN"
    echo "the legacy ModSecurity loader repair failed Nginx validation and was rolled back" >&2
    return 1
  fi
  rm -f "$backup"
  systemctl reload nginx >/dev/null 2>&1 || true
  echo "repaired legacy ModSecurity OWASP CRS loader"
}
valid_domain() {
  local domain="$1" label
  local -a labels
  [[ "$domain" == "${domain,,}" && ${#domain} -le 253 && "$domain" == *.* && "$domain" != *..* ]] || die "invalid domain"
  IFS=. read -ra labels <<<"$domain"
  for label in "${labels[@]}"; do
    [[ ${#label} -ge 1 && ${#label} -le 63 && "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "invalid domain"
  done
}
valid_path()   { [[ "$1" =~ ^/[a-zA-Z0-9._/-]+$ && "$1" != *".."* ]] || die "invalid path"; }
valid_php()    { [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]] || die "invalid php version"; }
valid_email()  { [[ -z "$1" || "$1" =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] || die "invalid email"; }
valid_user()   { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid user"; }
valid_group()  { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid group"; }
valid_site_id(){ [[ "$1" =~ ^[a-f0-9]{32}$ ]] || die "invalid site id"; }
valid_component(){ [[ "$1" != "." && "$1" != ".." && "$1" =~ ^[A-Za-z0-9._\ -]{1,255}$ ]] || die "invalid path component"; }
valid_docker_id(){ [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$ ]] || die "invalid Docker identifier"; }
valid_docker_name(){ [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || die "invalid Docker name"; }
valid_pinned_image() {
  local image="$1" tail
  [[ ${#image} -le 255 && "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._/@:-]+$ ]] || die "invalid Docker image"
  if [[ "$image" =~ @sha256:[a-f0-9]{64}$ ]]; then return; fi
  tail="${image##*/}"
  [[ "$tail" == *:* && "${tail##*:}" != "latest" ]] || die "Docker image must use a non-latest tag or digest"
}
compose_policy_check() {
  local file="$1" line value
  [[ "$(stat -c %s "$file")" -le 262144 ]] || die "Compose file is too large"
  grep -Eq '^[[:space:]]*services[[:space:]]*:' "$file" || die "Compose services are required"
  if grep -Eiq \
    '^[[:space:]]*(privileged[[:space:]]*:[[:space:]]*true|(network_mode|pid|ipc|uts|userns_mode)[[:space:]]*:[[:space:]]*host|devices[[:space:]]*:|cap_add[[:space:]]*:|type[[:space:]]*:[[:space:]]*bind|build[[:space:]]*:|env_file[[:space:]]*:|extends[[:space:]]*:|include[[:space:]]*:|configs[[:space:]]*:|secrets[[:space:]]*:|volumes_from[[:space:]]*:|published[[:space:]]*:|driver_opts[[:space:]]*:|cgroup[^:]*:|sysctls[[:space:]]*:)' "$file"; then
    die "Compose policy rejected a host-integrated option"
  fi
  grep -Eiq '/var/run/docker\.sock|^[[:space:]]*-[[:space:]]*["'\'']?(/|\./|\.\./|~/)[^:]*:' "$file" \
    && die "Compose policy rejected a host bind mount"
  grep -Eq '\$\{' "$file" && die "Compose variable interpolation is not allowed"
  grep -Eiq '^[[:space:]]*image[[:space:]]*:' "$file" || die "Compose services must use pinned images"
  while IFS= read -r line; do
    value="${line#*:}"; value="${value%%#*}"; value="${value//[[:space:]\"\']/}"
    [[ -n "$value" ]] || die "invalid Compose image"
    valid_pinned_image "$value"
  done < <(grep -Ei '^[[:space:]]*image[[:space:]]*:' "$file")
  while IFS= read -r line; do
    value="${line#*-}"; value="${value//[[:space:]\"\']/}"
    if [[ "$value" =~ ^([0-9.]+|\[[0-9a-fA-F:]+\]|::):[0-9]+:[0-9]+(/(tcp|udp))?$ ]]; then
      [[ "$value" == 127.0.0.1:* || "$value" == \[::1\]:* ]] || die "published ports must bind to loopback"
    elif [[ "$value" =~ ^[0-9]+:[0-9]+(/(tcp|udp))?$ ]]; then
      die "published ports must bind to loopback"
    fi
  done < <(grep -E '^[[:space:]]*-[[:space:]]*["'\'']?[^[:space:]]+:[^[:space:]]+' "$file" || true)
}
compose_file_check() {
  local name="$1" requested="$2" allow_staging="${3:-no}" panel_root stack_root target base
  [[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,49}$ ]] || die "invalid Compose project"
  [[ -r "$PANEL_ROOT_FILE" ]] || die "panel root is not configured"
  panel_root="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")"
  stack_root="$panel_root/data/stacks/$name"
  target="$(realpath "$requested" 2>/dev/null || true)"
  [[ -n "$target" && -f "$target" && ! -L "$target" ]] || die "Compose file not found"
  base="$(basename "$target")"
  if [[ "$allow_staging" == yes ]]; then
    [[ "$base" =~ ^\.validate-[a-f0-9]{12}\.yml$ ]] || die "invalid Compose validation file"
  else
    [[ "$base" == docker-compose.yml ]] || die "invalid Compose file"
  fi
  [[ "$target" == "$stack_root/$base" ]] || die "Compose file is outside its managed stack"
  printf '%s\n' "$target"
}

site_paths() {
  local id="$1"
  valid_site_id "$id"
  SITE_BASE="$SITES_ROOT/$id"
  SITE_PUBLIC="$SITE_BASE/public"
  SITE_USER="nebula-s-${id:0:12}"
  SITE_STATE="$SITES_STATE/$id"
}

site_state_check() {
  local id="$1" expected_domain="${2:-}"
  site_paths "$id"
  [[ -f "$SITE_STATE" && ! -L "$SITE_STATE" ]] || die "site registry entry not found"
  local state_domain state_path state_dev state_ino actual
  state_domain="$(sed -n 's/^domain=//p' "$SITE_STATE")"
  state_path="$(sed -n 's/^path=//p' "$SITE_STATE")"
  state_dev="$(sed -n 's/^device=//p' "$SITE_STATE")"
  state_ino="$(sed -n 's/^inode=//p' "$SITE_STATE")"
  [[ "$state_path" == "$SITE_PUBLIC" ]] || die "site registry path mismatch"
  [[ -z "$expected_domain" || "$state_domain" == "$expected_domain" ]] || die "site registry domain mismatch"
  [[ -d "$SITE_PUBLIC" && ! -L "$SITE_BASE" && ! -L "$SITE_PUBLIC" ]] || die "site path is missing or unsafe"
  mountpoint -q "$SITE_BASE" && die "site path is a mount point"
  mountpoint -q "$SITE_PUBLIC" && die "site public path is a mount point"
  actual="$(stat -c '%d:%i' "$SITE_PUBLIC")"
  [[ "$actual" == "$state_dev:$state_ino" ]] || die "site filesystem identity changed"
}

# Schedule PHP-FPM work after the current panel FastCGI response can finish.
schedule_php_service() {
  local action="$1" ver="$2" unit
  [[ "$action" == "reload" || "$action" == "restart" ]] || die "invalid PHP service action"
  valid_php "$ver"
  unit="nebula-php${ver//./-}-${action}-$(date +%s)-$$-$RANDOM"
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --quiet --unit="$unit" --on-active=2s /bin/sh -c \
      "systemctl ${action} php${ver}-fpm 2>/dev/null || systemctl restart php${ver}-fpm 2>/dev/null || true" || true
  else
    nohup /bin/sh -c "sleep 2; systemctl ${action} php${ver}-fpm 2>/dev/null || systemctl restart php${ver}-fpm 2>/dev/null || true" \
      >/dev/null 2>&1 &
  fi
}

# Resolve a path and prove it is inside the installer-owned File Manager root.
fm_confined_path() {
  local requested="$1" root target panel_root
  [[ -r "$FM_ROOT_FILE" ]] || die "file manager root is not configured; re-run install.sh"
  root="$(realpath "$(head -n 1 "$FM_ROOT_FILE")" 2>/dev/null || true)"
  target="$(realpath "$requested" 2>/dev/null || true)"
  [[ -n "$root" && -n "$target" ]] || die "path not found"
  [[ "$target" == "$root" || "$target" == "$root"/* ]] || die "path is outside file manager root"
  panel_root="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE" 2>/dev/null)" 2>/dev/null || true)"
  [[ -z "$panel_root" || ( "$target" != "$panel_root" && "$target" != "$panel_root"/* ) ]] || die "panel-private path is not allowed"
  printf '%s\n' "$target"
}

# Resolve a not-yet-created path by validating its existing parent.
fm_confined_new_path() {
  local requested="$1" root parent target panel_root base
  [[ -r "$FM_ROOT_FILE" ]] || die "file manager root is not configured; re-run install.sh"
  root="$(realpath "$(head -n 1 "$FM_ROOT_FILE")" 2>/dev/null || true)"
  parent="$(realpath "$(dirname "$requested")" 2>/dev/null || true)"
  [[ -n "$root" && -n "$parent" ]] || die "destination parent not found"
  [[ "$parent" == "$root" || "$parent" == "$root"/* ]] || die "destination is outside file manager root"
  base="$(basename "$requested")"; valid_component "$base"
  target="$parent/$base"
  panel_root="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE" 2>/dev/null)" 2>/dev/null || true)"
  [[ -z "$panel_root" || ( "$target" != "$panel_root" && "$target" != "$panel_root"/* ) ]] || die "panel-private destination is not allowed"
  [[ ! -e "$target" ]] || die "destination already exists"
  printf '%s\n' "$target"
}

# Print "uid:gid:home" for a real interactive account; reject system users.
human_user_info() {
  local user="$1" row uid gid home
  valid_user "$user"
  row="$(getent passwd "$user" || true)"; [[ -n "$row" ]] || die "user not found"
  IFS=: read -r _ _ uid gid _ home _ <<<"$row"
  [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]] || die "not a human user"
  valid_path "$home"
  printf '%s:%s:%s\n' "$uid" "$gid" "$home"
}

CMD="${1:-}"; shift || true

# Serialize every action that may invoke apt/dpkg. Resource-specific locks are
# acquired separately inside the relevant action.
case "$CMD" in
  php-install|php-extension|composer-install|modsec-install|modsec-uninstall|compose-install|pma-install|pma-remove|mail-setup|roundcube-install|roundcube-remove|webmail-remove)
    exec 7>/run/lock/nebula-panel-packages.lock
    flock -w 120 7 || die "another package operation is running"
    repair_legacy_modsecurity_loader \
      || die "repair the ModSecurity configuration before installing packages"
    ;;
esac

case "$CMD" in

  helper-self-test)
    TEST_FILE="$(mktemp)"; trap 'rm -f "$TEST_FILE"' EXIT
    TEST_SQL="CREATE DATABASE \`nebula_contract_test\`;"
    TEST_ENCODED="$(printf '%s' "$TEST_SQL" | base64 | tr -d '\n')"
    decode_payload_file "$TEST_ENCODED" "$TEST_FILE" 262144 || die "Base64 contract failed"
    [[ "$(<"$TEST_FILE")" == "$TEST_SQL" ]] || die "decoded SQL changed"
    NULL_ENCODED="$(printf 'safe\000unsafe' | base64 | tr -d '\n')"
    if decode_payload_file "$NULL_ENCODED" "$TEST_FILE" 262144; then
      die "NUL payload was accepted"
    fi
    [[ "$(broker_request_allowed "DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y 'docker.io'")" == apt ]] \
      || die "valid package request was rejected"
    if broker_request_allowed "apt-get install -y docker.io; id" >/dev/null; then
      die "unsafe package request was accepted"
    fi
    echo "helper payload and broker contracts passed"
    ;;

  broker-command)
    ENCODED="${1:-}"
    PAYLOAD="$(mktemp)"; trap 'rm -f "$PAYLOAD"' EXIT
    decode_payload_file "$ENCODED" "$PAYLOAD" 4096 || die "invalid broker payload"
    REQUEST="$(<"$PAYLOAD")"
    REQUEST="${REQUEST% 2>&1}"
    [[ "$REQUEST" != *$'\n'* && "$REQUEST" != *$'\r'* ]] || die "invalid command"
    REQUEST_KIND="$(broker_request_allowed "$REQUEST" || true)"
    if [[ "$REQUEST_KIND" == apt ]]; then
      exec 9>/run/lock/nebula-panel-packages.lock
      flock -w 120 9 || die "another package operation is running"
      repair_legacy_modsecurity_loader \
        || die "repair the ModSecurity configuration before installing packages"
      timeout 900s /bin/bash -c "$REQUEST"
    elif [[ "$REQUEST_KIND" == ufw ]]; then
      timeout 60s /bin/bash -c "$REQUEST"
    else
      die "command is not an allowed broker operation"
    fi
    ;;

  db-query)
    ENCODED="${1:-}"; PAYLOAD="$(mktemp)"; trap 'rm -f "$PAYLOAD"' EXIT
    decode_payload_file "$ENCODED" "$PAYLOAD" 262144 || die "invalid SQL payload"
    timeout 120s mysql -N -B < "$PAYLOAD"
    ;;

  service-action)
    ACTION="${1:-}"; UNIT="${2:-}"
    [[ "$ACTION" == "start" || "$ACTION" == "stop" || "$ACTION" == "restart" || "$ACTION" == "enable" || "$ACTION" == "disable" ]] \
      || die "invalid service action"
    case "$UNIT" in
      nginx|apache2|mariadb|mysql|redis-server|memcached|docker|fail2ban|ssh|cron|ufw|php[0-9].[0-9]-fpm) ;;
      *) die "service is not allowed" ;;
    esac
    systemctl "$ACTION" "$UNIT"
    case "$ACTION" in
      start|restart)
        systemctl is-active --quiet "$UNIT" || die "service did not reach the active state"
        ;;
      stop)
        if systemctl is-active --quiet "$UNIT"; then die "service did not stop"; fi
        ;;
      enable)
        systemctl is-enabled --quiet "$UNIT" || die "service was not enabled"
        ;;
      disable)
        if systemctl is-enabled --quiet "$UNIT"; then die "service was not disabled"; fi
        ;;
    esac
    ;;

  # Typed Docker operations. Never accept a raw Docker command: access to the
  # daemon is root-equivalent, so every option and resource is reconstructed.
  docker-query)
    QUERY="${1:-}"
    case "$QUERY" in
      containers) timeout 30s docker ps -a --format '{{json .}}' ;;
      images) timeout 30s docker images --format '{{json .}}' ;;
      volumes) timeout 30s docker volume ls --format '{{json .}}' ;;
      networks) timeout 30s docker network ls --format '{{json .}}' ;;
      version) timeout 20s docker version --format '{{.Server.Version}}' ;;
      *) die "invalid Docker query" ;;
    esac
    ;;

  docker-run)
    NAME="${1:-}"; IMAGE="${2:-}"; RESTART="${3:-}"; PORTS64="${4:-}"; ENV64="${5:-}"; VOLUMES64="${6:-}"
    valid_docker_name "$NAME"; valid_pinned_image "$IMAGE"
    [[ "$RESTART" == no || "$RESTART" == always || "$RESTART" == unless-stopped || "$RESTART" == on-failure ]] || die "invalid restart policy"
    PORTS="$(printf '%s' "$PORTS64" | base64 -d 2>/dev/null)" || die "invalid port payload"
    ENVS="$(printf '%s' "$ENV64" | base64 -d 2>/dev/null)" || die "invalid environment payload"
    VOLUMES="$(printf '%s' "$VOLUMES64" | base64 -d 2>/dev/null)" || die "invalid volume payload"
    ARGS=(docker run -d --name "$NAME" --restart "$RESTART" --security-opt no-new-privileges
      --pids-limit 256 --memory 1g --log-opt max-size=10m --log-opt max-file=3)
    while IFS= read -r port; do
      [[ -z "$port" ]] && continue
      [[ "$port" =~ ^(127\.0\.0\.1|\[::1\]):([0-9]{1,5}):([0-9]{1,5})(/(tcp|udp))?$ ]] || die "invalid port mapping"
      (( 10#${BASH_REMATCH[2]} >= 1 && 10#${BASH_REMATCH[2]} <= 65535
        && 10#${BASH_REMATCH[3]} >= 1 && 10#${BASH_REMATCH[3]} <= 65535 )) || die "invalid port mapping"
      ARGS+=(-p "$port")
    done <<<"$PORTS"
    while IFS= read -r env; do
      [[ -z "$env" ]] && continue
      [[ ${#env} -le 1153 && "$env" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "invalid environment entry"
      ARGS+=(-e "$env")
    done <<<"$ENVS"
    while IFS= read -r volume; do
      [[ -z "$volume" ]] && continue
      [[ "$volume" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}:/[A-Za-z0-9_./-]+(:r[ow])?$ ]] || die "only named volumes are allowed"
      ARGS+=(-v "$volume")
    done <<<"$VOLUMES"
    ARGS+=("$IMAGE")
    timeout 180s "${ARGS[@]}"
    ;;

  docker-pull)
    IMAGE="${1:-}"; valid_pinned_image "$IMAGE"; timeout 300s docker pull "$IMAGE"
    ;;

  docker-resource)
    KIND="${1:-}"; OP="${2:-}"; NAME="${3:-}"; valid_docker_name "$NAME"
    [[ "$KIND" == volume || "$KIND" == network ]] || die "invalid Docker resource"
    [[ "$OP" == create || "$OP" == rm ]] || die "invalid Docker resource action"
    [[ "$KIND:$OP:$NAME" != "network:rm:bridge" && "$KIND:$OP:$NAME" != "network:rm:host" && "$KIND:$OP:$NAME" != "network:rm:none" ]] \
      || die "built-in networks cannot be removed"
    timeout 60s docker "$KIND" "$OP" "$NAME"
    ;;

  docker-container)
    ACTION="${1:-}"; ID="${2:-}"; valid_docker_id "$ID"
    case "$ACTION" in
      start|stop|restart) timeout 60s docker "$ACTION" "$ID" ;;
      remove) timeout 60s docker rm -f "$ID" ;;
      *) die "invalid container action" ;;
    esac
    ;;

  docker-image-remove)
    ID="${1:-}"; valid_docker_id "$ID"; timeout 60s docker rmi "$ID"
    ;;

  docker-image-prune)
    [[ $# -eq 0 ]] || die "unexpected arguments"; timeout 120s docker image prune -f
    ;;

  docker-logs)
    ID="${1:-}"; LINES="${2:-200}"; valid_docker_id "$ID"
    [[ "$LINES" =~ ^[0-9]+$ && "$LINES" -ge 1 && "$LINES" -le 2000 ]] || die "invalid line limit"
    timeout 60s docker logs --tail "$LINES" "$ID" 2>&1 | head -c 2097152
    ;;

  compose-version)
    IMPL="${1:-}"
    case "$IMPL" in
      plugin) timeout 20s docker compose version ;;
      standalone) timeout 20s docker-compose version ;;
      *) die "invalid Compose implementation" ;;
    esac
    ;;

  compose-list)
    IMPL="${1:-}"
    case "$IMPL" in
      plugin) timeout 30s docker compose ls --all --format json ;;
      standalone) timeout 30s docker-compose ls --all --format json ;;
      *) die "invalid Compose implementation" ;;
    esac
    ;;

  compose-run)
    IMPL="${1:-}"; OP="${2:-}"; NAME="${3:-}"; FILE="${4:-}"; EXTRA="${5:-}"; SOURCE=""
    case "$IMPL" in
      plugin) COMPOSE=(docker compose) ;;
      standalone) COMPOSE=(docker-compose) ;;
      *) die "invalid Compose implementation" ;;
    esac
    if [[ "$OP" == validate ]]; then
      SOURCE="$(compose_file_check "$NAME" "$FILE" yes)"
      FILE="$(mktemp /run/nebula-compose.XXXXXX.yml)"
      trap 'rm -f "$FILE"' EXIT
      install -m 0600 -o root -g root "$SOURCE" "$FILE"
      compose_policy_check "$FILE"
      timeout 60s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" config --quiet
      exit
    fi
    SOURCE="$(compose_file_check "$NAME" "$FILE")"
    FILE="$(mktemp /run/nebula-compose.XXXXXX.yml)"
    trap 'rm -f "$FILE"' EXIT
    install -m 0600 -o root -g root "$SOURCE" "$FILE"
    compose_policy_check "$FILE"
    case "$OP" in
      up) timeout 600s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" up -d --remove-orphans ;;
      down) timeout 180s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" down ;;
      stop|start|restart|pull) timeout 600s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" "$OP" ;;
      destroy) timeout 180s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" down -v --remove-orphans ;;
      logs)
        [[ "$EXTRA" =~ ^[0-9]+$ && "$EXTRA" -ge 1 && "$EXTRA" -le 2000 ]] || die "invalid line limit"
        timeout 60s "${COMPOSE[@]}" -p "$NAME" -f "$FILE" logs --no-color --tail "$EXTRA" | head -c 2097152
        ;;
      *) die "invalid Compose action" ;;
    esac
    ;;

  log-read-unit)
    UNIT="${1:-}"; LINES="${2:-200}"
    [[ "$LINES" =~ ^[0-9]+$ && "$LINES" -ge 10 && "$LINES" -le 2000 ]] || die "invalid line limit"
    case "$UNIT" in
      nginx|apache2|mariadb|mysql|php[0-9].[0-9]-fpm|redis-server|docker|ssh|cron|ufw) ;;
      *) die "log unit is not allowed" ;;
    esac
    timeout 10s journalctl -u "$UNIT" -n "$LINES" --no-pager --output=short-iso \
      | head -c 1048576
    ;;

  log-read-file)
    LOG_PATH="${1:-}"; LINES="${2:-200}"
    [[ "$LINES" =~ ^[0-9]+$ && "$LINES" -ge 10 && "$LINES" -le 2000 ]] || die "invalid line limit"
    case "$LOG_PATH" in
      /var/log/syslog|/var/log/auth.log|/var/log/kern.log|/var/log/dpkg.log|/var/log/nginx/*.log|/var/log/apache2/*.log) ;;
      *) die "log file is not allowed" ;;
    esac
    [[ -f "$LOG_PATH" && ! -L "$LOG_PATH" ]] || die "log file not found"
    timeout 10s tail -n "$LINES" -- "$LOG_PATH" | head -c 1048576
    ;;

  # panel-update <staged-panel-source>
  # Source must be staged by Nebula beneath its private data/_update folder.
  panel-update)
    exec 9>/run/lock/nebula-panel-update.lock
    flock -n 9 || die "another panel update is already running"
    SOURCE="${1:-}"
    [[ -r "$PANEL_ROOT_FILE" ]] || die "panel root is not configured; re-run install.sh"
    PANEL_ROOT="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")"
    SOURCE="$(realpath "$SOURCE" 2>/dev/null || true)"
    [[ -n "$PANEL_ROOT" && -n "$SOURCE" ]] || die "update source not found"
    [[ "$SOURCE" == "$PANEL_ROOT/data/_update/"* ]] || die "update source is outside the staging directory"
    [[ -f "$SOURCE/index.php" && -f "$SOURCE/lib/bootstrap.php" ]] || die "invalid panel update source"
    command -v rsync >/dev/null || die "rsync is required"
    SNAP_DIR="$PANEL_ROOT/data/backups"; mkdir -p "$SNAP_DIR"
    SNAP="$SNAP_DIR/pre-update-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$SNAP" --exclude='data/backups' --exclude='data/_update' -C "$(dirname "$PANEL_ROOT")" "$(basename "$PANEL_ROOT")"
    PANEL_USER="$(stat -c %U "$PANEL_ROOT/data")"
    chown "$PANEL_USER:$PANEL_USER" "$SNAP"; chmod 0600 "$SNAP"
    find "$SNAP_DIR" -maxdepth 1 -type f -name 'pre-update-*.tar.gz' -printf '%T@ %p\n' \
      | sort -nr | awk 'NR>5 {$1=""; sub(/^ /,""); print}' | xargs -r rm -f --
    MAINTENANCE="$PANEL_ROOT/data/maintenance"
    install -m 0600 -o "$PANEL_USER" -g "$PANEL_USER" /dev/null "$MAINTENANCE"
    ROLLBACK_TMP="$(mktemp -d)"
    cleanup_panel_update() { rm -f "$MAINTENANCE"; rm -rf "$ROLLBACK_TMP"; }
    trap cleanup_panel_update EXIT
    rollback_panel_update() {
      tar -xzf "$SNAP" -C "$ROLLBACK_TMP"
      PREVIOUS="$ROLLBACK_TMP/$(basename "$PANEL_ROOT")"
      [[ -f "$PREVIOUS/index.php" ]] || die "automatic rollback snapshot is invalid"
      rsync -a --delete --exclude=data --exclude=config.php "$PREVIOUS/" "$PANEL_ROOT/"
    }
    if ! rsync -a --delete --exclude=data --exclude=config.php "$SOURCE/" "$PANEL_ROOT/"; then
      rollback_panel_update
      die "update copy failed; previous release restored"
    fi
    if [[ ! -f "$PANEL_ROOT/index.php" || ! -f "$PANEL_ROOT/lib/bootstrap.php" ]] \
      || ! php -l "$PANEL_ROOT/index.php" >/dev/null 2>&1; then
      rollback_panel_update
      die "post-deploy health check failed; previous release restored"
    fi
    find "$PANEL_ROOT" -path "$PANEL_ROOT/data" -prune -o -type d -exec chown root:root {} + -exec chmod 0755 {} +
    find "$PANEL_ROOT" -path "$PANEL_ROOT/data" -prune -o -type f -exec chown root:root {} + -exec chmod 0644 {} +
    chown -R "$PANEL_USER:$PANEL_USER" "$PANEL_ROOT/data"
    chmod 0700 "$PANEL_ROOT/data"
    # Refresh the privileged helper itself from the staged, hash-verified
    # release so panel self-updates deliver helper changes too. Without this,
    # new helper actions (e.g. a new webmail installer) fail with
    # "unknown command" until install.sh is re-run by hand. Validate the staged
    # helper first so a corrupt file can never brick the privileged surface.
    if [[ -f "$SOURCE/bin/nebula-helper" ]]; then
      if head -n1 "$SOURCE/bin/nebula-helper" | grep -q '^#!.*bash' && bash -n "$SOURCE/bin/nebula-helper" 2>/dev/null; then
        install -m 0755 -o root -g root "$SOURCE/bin/nebula-helper" /usr/local/bin/nebula-helper
        echo "helper=updated"
      else
        echo "helper=skipped-invalid" >&2
      fi
    fi
    if [[ -f "$SOURCE/bin/nebula-recovery" ]] && bash -n "$SOURCE/bin/nebula-recovery"; then
      install -m 0755 -o root -g root "$SOURCE/bin/nebula-recovery" /usr/local/sbin/nebula-recovery
    fi
    cleanup_panel_update
    trap - EXIT
    echo "snapshot=$(basename "$SNAP")"
    ;;

  # dns-zone-put <domain> <base64-zone-file>
  dns-zone-put)
    DOMAIN="${1:-}"; ZONE_B64="${2:-}"; valid_domain "$DOMAIN"
    exec 8>/run/lock/nebula-panel-dns.lock
    flock -w 30 8 || die "another DNS operation is running"
    [[ "$ZONE_B64" =~ ^[A-Za-z0-9+/=]+$ ]] || die "invalid zone encoding"
    if ! command -v named-checkzone >/dev/null; then
      exec 9>/run/lock/nebula-panel-packages.lock
      flock -w 120 9 || die "another package operation is running"
      DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
      DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y bind9 bind9-utils
    fi
    TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
    printf '%s' "$ZONE_B64" | base64 -d > "$TMP" 2>/dev/null || die "invalid zone data"
    named-checkzone "$DOMAIN" "$TMP" >/dev/null || die "BIND rejected the zone"
    install -d -m 0755 -o root -g bind "$BIND_ZONE_DIR"
    ROLLBACK="$(mktemp -d)"
    ZONE_PATH="$BIND_ZONE_DIR/db.$DOMAIN"
    for path in "$ZONE_PATH" "$BIND_ZONE_CONF" /etc/bind/named.conf.local; do
      key="$(printf '%s' "$path" | sha256sum | awk '{print $1}')"
      if [[ -e "$path" ]]; then cp -a "$path" "$ROLLBACK/$key"; else : > "$ROLLBACK/$key.missing"; fi
    done
    rollback_dns() {
      local path key
      for path in "$ZONE_PATH" "$BIND_ZONE_CONF" /etc/bind/named.conf.local; do
        key="$(printf '%s' "$path" | sha256sum | awk '{print $1}')"
        if [[ -f "$ROLLBACK/$key.missing" ]]; then rm -f "$path"; else cp -a "$ROLLBACK/$key" "$path"; fi
      done
      systemctl reload bind9 >/dev/null 2>&1 || true
      rm -rf "$ROLLBACK"
    }
    install -m 0644 -o root -g bind "$TMP" "$ZONE_PATH"
    touch "$BIND_ZONE_CONF"; chown root:bind "$BIND_ZONE_CONF"; chmod 0644 "$BIND_ZONE_CONF"
    if ! grep -qF "zone \"$DOMAIN\"" "$BIND_ZONE_CONF"; then
      printf 'zone "%s" {\n  type primary;\n  file "%s/db.%s";\n};\n' "$DOMAIN" "$BIND_ZONE_DIR" "$DOMAIN" >> "$BIND_ZONE_CONF"
    fi
    if ! grep -qF 'include "/etc/bind/nebula-zones.conf";' /etc/bind/named.conf.local; then
      printf '\ninclude "/etc/bind/nebula-zones.conf";\n' >> /etc/bind/named.conf.local
    fi
    if ! named-checkconf >/dev/null || ! (systemctl reload bind9 2>/dev/null || systemctl restart bind9); then
      rollback_dns
      die "BIND validation or reload failed; previous configuration restored"
    fi
    rm -rf "$ROLLBACK"
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
      ufw allow 53/tcp >/dev/null
      ufw allow 53/udp >/dev/null
    fi
    echo "published authoritative zone $DOMAIN"
    ;;

  dns-zone-delete)
    DOMAIN="${1:-}"; valid_domain "$DOMAIN"
    exec 8>/run/lock/nebula-panel-dns.lock
    flock -w 30 8 || die "another DNS operation is running"
    ROLLBACK="$(mktemp -d)"
    ZONE_PATH="$BIND_ZONE_DIR/db.$DOMAIN"
    [[ -e "$ZONE_PATH" ]] && cp -a "$ZONE_PATH" "$ROLLBACK/zone" || : > "$ROLLBACK/zone.missing"
    [[ -e "$BIND_ZONE_CONF" ]] && cp -a "$BIND_ZONE_CONF" "$ROLLBACK/conf" || : > "$ROLLBACK/conf.missing"
    if [[ -f "$BIND_ZONE_CONF" ]]; then
      TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
      awk -v target="zone \"$DOMAIN\"" '
        index($0,target)==1 { skip=1 }
        skip && /^};[[:space:]]*$/ { skip=0; next }
        !skip { print }
      ' "$BIND_ZONE_CONF" > "$TMP"
      install -m 0644 -o root -g bind "$TMP" "$BIND_ZONE_CONF"
    fi
    rm -f "$ZONE_PATH"
    if ! named-checkconf >/dev/null || ! (systemctl reload bind9 2>/dev/null || systemctl restart bind9); then
      [[ -f "$ROLLBACK/zone.missing" ]] || cp -a "$ROLLBACK/zone" "$ZONE_PATH"
      if [[ -f "$ROLLBACK/conf.missing" ]]; then rm -f "$BIND_ZONE_CONF"; else cp -a "$ROLLBACK/conf" "$BIND_ZONE_CONF"; fi
      systemctl reload bind9 >/dev/null 2>&1 || true
      rm -rf "$ROLLBACK"
      die "BIND rejected zone removal; previous configuration restored"
    fi
    rm -rf "$ROLLBACK"
    echo "removed authoritative zone $DOMAIN"
    ;;

  # File metadata operations are confined by /etc/nebula-panel/fm-root.
  file-chmod)
    TARGET="$(fm_confined_path "${1:-}")"; MODE="${2:-}"
    [[ "$MODE" =~ ^[0-7]{3}$ ]] || die "invalid mode"
    chmod "$MODE" "$TARGET"
    echo "permissions updated"
    ;;

  file-mkdir)
    TARGET="$(fm_confined_new_path "${1:-}")"
    PARENT="$(dirname "$TARGET")"; OWNER="$(stat -c %U "$PARENT")"; GROUP="$(stat -c %G "$PARENT")"
    install -d -m 0750 -o "$OWNER" -g "$GROUP" "$TARGET"
    PANEL_USER="$(stat -c %U "$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")/data")"
    setfacl -m "u:${PANEL_USER}:rX,d:u:${PANEL_USER}:rX" "$TARGET"
    ;;

  file-mkfile)
    TARGET="$(fm_confined_new_path "${1:-}")"
    PARENT="$(dirname "$TARGET")"; OWNER="$(stat -c %U "$PARENT")"; GROUP="$(stat -c %G "$PARENT")"
    install -m 0640 -o "$OWNER" -g "$GROUP" /dev/null "$TARGET"
    PANEL_USER="$(stat -c %U "$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")/data")"
    setfacl -m "u:${PANEL_USER}:r" "$TARGET"
    ;;

  file-rename)
    RAW_SOURCE="${1:-}"; RAW_TARGET="${2:-}"
    [[ ! -L "$RAW_SOURCE" ]] || die "symlink operations are not allowed"
    SOURCE="$(fm_confined_path "$RAW_SOURCE")"
    TARGET="$(fm_confined_new_path "$RAW_TARGET")"
    [[ "$(dirname "$SOURCE")" == "$(dirname "$TARGET")" ]] || die "rename must stay in the same directory"
    mv -- "$SOURCE" "$TARGET"
    ;;

  file-op)
    OP="${1:-}"; RAW_SOURCE="${2:-}"; RAW_TARGET="${3:-}"
    [[ "$OP" == "copy" || "$OP" == "move" ]] || die "invalid file operation"
    [[ ! -L "$RAW_SOURCE" ]] || die "symlink operations are not allowed"
    SOURCE="$(fm_confined_path "$RAW_SOURCE")"
    TARGET="$(fm_confined_new_path "$RAW_TARGET")"
    if [[ -d "$SOURCE" && "$TARGET" == "$SOURCE"/* ]]; then die "cannot place a directory inside itself"; fi
    if [[ "$OP" == "copy" ]]; then cp -a --no-dereference -- "$SOURCE" "$TARGET"; else mv -- "$SOURCE" "$TARGET"; fi
    ;;

  # Install a panel-staged file at an existing or new confined path while
  # preserving/deriving the site owner's identity. The panel process itself
  # never receives write access to site source.
  file-install)
    STAGED="${1:-}"; RAW_TARGET="${2:-}"; OVERWRITE="${3:-no}"
    [[ -r "$PANEL_ROOT_FILE" ]] || die "panel root is not configured"
    PANEL_ROOT="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")"
    STAGE_ROOT="$PANEL_ROOT/data/file-staging"
    STAGED="$(realpath "$STAGED" 2>/dev/null || true)"
    [[ -n "$STAGED" && "$STAGED" == "$STAGE_ROOT/"* && -f "$STAGED" && ! -L "$STAGED" ]] || die "invalid staged file"
    [[ "$(stat -c %s "$STAGED")" -le 52428800 ]] || die "staged file exceeds 50 MB"
    if [[ -e "$RAW_TARGET" ]]; then
      [[ "$OVERWRITE" == yes && -f "$RAW_TARGET" && ! -L "$RAW_TARGET" ]] || die "target exists"
      TARGET="$(fm_confined_path "$RAW_TARGET")"
      OWNER="$(stat -c %U "$TARGET")"; GROUP="$(stat -c %G "$TARGET")"; MODE="$(stat -c %a "$TARGET")"
    else
      TARGET="$(fm_confined_new_path "$RAW_TARGET")"
      OWNER="$(stat -c %U "$(dirname "$TARGET")")"; GROUP="$(stat -c %G "$(dirname "$TARGET")")"; MODE=0640
    fi
    TEMP="$(dirname "$TARGET")/.nebula-install-$(od -An -N6 -tx1 /dev/urandom | tr -d '[:space:]')"
    install -m "$MODE" -o "$OWNER" -g "$GROUP" "$STAGED" "$TEMP"
    mv -f -- "$TEMP" "$TARGET"
    rm -f "$STAGED"
    PANEL_USER="$(stat -c %U "$PANEL_ROOT/data")"
    setfacl -m "u:${PANEL_USER}:r" "$TARGET"
    ;;

  # file-delete <path> — move an entry to root-owned recovery trash.
  file-delete)
    TARGET="$(fm_confined_path "${1:-}")"
    ROOT="$(realpath "$(head -n 1 "$FM_ROOT_FILE")")"
    [[ -n "$ROOT" && "$TARGET" != "$ROOT" ]] || die "refusing to delete the file manager root"
    install -d -m 0700 -o root -g root "$FILE_TRASH"
    TRASH_NAME="$(date +%Y%m%d-%H%M%S)-$(basename "$TARGET")-$(od -An -N4 -tx1 /dev/urandom | tr -d '[:space:]')"
    mv -- "$TARGET" "$FILE_TRASH/$TRASH_NAME"
    chown -R root:root "$FILE_TRASH/$TRASH_NAME"
    echo "archived=$FILE_TRASH/$TRASH_NAME"
    ;;

  # file-compress <zip|tar.gz> <absolute-target> <absolute-source> [...]
  # Both destination and sources are independently confined below FM_ROOT.
  file-compress)
    FORMAT="${1:-}"; shift || true
    TARGET="$(fm_confined_new_path "${1:-}")"; shift || true
    [[ "$FORMAT" == "zip" || "$FORMAT" == "tar.gz" ]] || die "unsupported archive format"
    [[ "$FORMAT" != "zip" || "$TARGET" == *.zip ]] || die "zip target must end in .zip"
    [[ "$FORMAT" != "tar.gz" || "$TARGET" == *.tar.gz ]] || die "tar target must end in .tar.gz"
    [[ "$#" -ge 1 && "$#" -le 100 ]] || die "select between 1 and 100 items"
    ROOT="$(realpath "$(head -n 1 "$FM_ROOT_FILE")")"
    RELS=()
    FIRST=""
    for REQUESTED in "$@"; do
      SOURCE="$(fm_confined_path "$REQUESTED")"
      [[ "$SOURCE" != "$ROOT" ]] || die "cannot archive the file manager root"
      [[ -n "$FIRST" ]] || FIRST="$SOURCE"
      RELS+=("${SOURCE#"$ROOT"/}")
    done
    if [[ "$FORMAT" == "zip" ]]; then
      command -v zip >/dev/null || die "zip is not installed; re-run install.sh"
      (cd "$ROOT" && zip -rq "$TARGET" -- "${RELS[@]}") || { rm -f "$TARGET"; die "zip creation failed"; }
    else
      tar -czf "$TARGET" -C "$ROOT" -- "${RELS[@]}" || { rm -f "$TARGET"; die "tar archive creation failed"; }
    fi
    chown --reference="$FIRST" "$TARGET" 2>/dev/null || true
    chmod 0640 "$TARGET" 2>/dev/null || true
    echo "created $TARGET"
    ;;

  # ssh-keys-list <user> / ssh-key-add <user> <base64-key> / ssh-key-delete <user> <line>
  ssh-keys-list)
    USER_NAME="${1:-}"; INFO="$(human_user_info "$USER_NAME")"; HOME_DIR="${INFO#*:*:}"
    KEY_FILE="$HOME_DIR/.ssh/authorized_keys"
    [[ -f "$KEY_FILE" ]] || exit 0
    N=0
    while IFS= read -r KEY_LINE || [[ -n "$KEY_LINE" ]]; do
      [[ -z "$KEY_LINE" || "$KEY_LINE" == \#* ]] && continue
      N=$((N + 1))
      META="$(printf '%s\n' "$KEY_LINE" | ssh-keygen -lf - 2>/dev/null || true)"
      [[ -n "$META" ]] && printf '%s\t%s\n' "$N" "$META"
    done < "$KEY_FILE"
    ;;

  ssh-key-add)
    USER_NAME="${1:-}"; KEY_B64="${2:-}"; INFO="$(human_user_info "$USER_NAME")"
    UID_NUM="${INFO%%:*}"; REST="${INFO#*:}"; GID_NUM="${REST%%:*}"; HOME_DIR="${INFO#*:*:}"
    [[ "$KEY_B64" =~ ^[A-Za-z0-9+/=]+$ ]] || die "invalid key encoding"
    KEY_LINE="$(printf '%s' "$KEY_B64" | base64 -d 2>/dev/null || true)"
    [[ "$KEY_LINE" != *$'\n'* && "$KEY_LINE" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] || die "invalid public key"
    printf '%s\n' "$KEY_LINE" | ssh-keygen -lf - >/dev/null 2>&1 || die "invalid public key"
    install -d -m 0700 -o "$UID_NUM" -g "$GID_NUM" "$HOME_DIR/.ssh"
    KEY_FILE="$HOME_DIR/.ssh/authorized_keys"
    touch "$KEY_FILE"; chown "$UID_NUM:$GID_NUM" "$KEY_FILE"; chmod 0600 "$KEY_FILE"
    grep -Fqx -- "$KEY_LINE" "$KEY_FILE" || printf '%s\n' "$KEY_LINE" >> "$KEY_FILE"
    echo "key added for $USER_NAME"
    ;;

  ssh-key-delete)
    USER_NAME="${1:-}"; KEY_NUM="${2:-}"; INFO="$(human_user_info "$USER_NAME")"
    UID_NUM="${INFO%%:*}"; REST="${INFO#*:}"; GID_NUM="${REST%%:*}"; HOME_DIR="${INFO#*:*:}"
    [[ "$KEY_NUM" =~ ^[1-9][0-9]*$ ]] || die "invalid key number"
    KEY_FILE="$HOME_DIR/.ssh/authorized_keys"; [[ -f "$KEY_FILE" ]] || die "key file not found"
    TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
    awk -v wanted="$KEY_NUM" 'BEGIN{n=0} /^[[:space:]]*($|#)/{print;next} {n++; if(n!=wanted) print}' "$KEY_FILE" > "$TMP"
    install -m 0600 -o "$UID_NUM" -g "$GID_NUM" "$TMP" "$KEY_FILE"
    echo "key removed for $USER_NAME"
    ;;

  # List installed PHP-FPM versions (one per line, e.g. 8.1).
  php-versions)
    ls /run/php/ 2>/dev/null | grep -oE 'php[0-9.]+-fpm\.sock' \
      | sed -E 's/php([0-9.]+)-fpm\.sock/\1/' | sort -uV
    ;;

  # site-create <site-id> <domain> <phpversion>
  site-create)
    SITE_ID="${1:-}"; DOMAIN="${2:-}"; PHPVER="${3:-}"
    valid_site_id "$SITE_ID"; valid_domain "$DOMAIN"; valid_php "$PHPVER"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_paths "$SITE_ID"
    FPM_DIR="/etc/php/${PHPVER}/fpm/pool.d"
    [[ -d "$FPM_DIR" ]] || die "PHP-FPM $PHPVER is not installed"
    SOCK="/run/php/nebula-site-${SITE_ID}.sock"
    [[ -e "$NGINX_AV/$DOMAIN" ]] && die "site already exists"
    [[ ! -e "$SITE_BASE" && ! -e "$SITE_STATE" ]] || die "site id already exists"
    install -d -m 0711 -o root -g root "$SITES_ROOT"
    mkdir -m 0750 "$SITE_BASE"
    getent passwd "$SITE_USER" >/dev/null 2>&1 \
      || useradd --system --home-dir "$SITE_BASE" --shell /usr/sbin/nologin "$SITE_USER"
    chown "$SITE_USER:$SITE_USER" "$SITE_BASE"
    install -d -m 0750 -o "$SITE_USER" -g "$SITE_USER" "$SITE_PUBLIC"
    printf '<!doctype html><html><body><h1>%s</h1><p>Provisioned by Nebula Panel. PHP %s.</p></body></html>\n' \
      "$DOMAIN" "$PHPVER" > "$SITE_PUBLIC/index.html"
    chown "$SITE_USER:$SITE_USER" "$SITE_PUBLIC/index.html"
    cat > "$FPM_DIR/nebula-site-${SITE_ID}.conf" <<EOF
[nebula-site-${SITE_ID}]
user = $SITE_USER
group = $SITE_USER
listen = $SOCK
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 20s
pm.max_requests = 500
clear_env = yes
security.limit_extensions = .php
chdir = $SITE_PUBLIC
php_admin_value[open_basedir] = $SITE_BASE:/tmp
php_admin_value[upload_tmp_dir] = $SITE_BASE/tmp
php_admin_value[session.save_path] = $SITE_BASE/sessions
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen
EOF
    install -d -m 0700 -o "$SITE_USER" -g "$SITE_USER" "$SITE_BASE/tmp" "$SITE_BASE/sessions"
    PANEL_USER="$(stat -c %U "$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")/data")"
    setfacl -m "u:${PANEL_USER}:rx" "$SITES_ROOT"
    setfacl -m "u:${PANEL_USER}:rx,u:www-data:rx" "$SITE_BASE"
    setfacl -R -m "u:${PANEL_USER}:rX,u:www-data:rX" "$SITE_PUBLIC"
    find "$SITE_PUBLIC" -type d -exec setfacl -m "d:u:${PANEL_USER}:rX,d:u:www-data:rX" {} +
    cat > "$NGINX_AV/$DOMAIN" <<EOF
# Managed by Nebula Panel. Site ID: $SITE_ID
server {
    listen 80;
    listen [::]:80;
    # Only configure the hostname the user entered. In particular, a site such
    # as app.example.com must not silently gain www.app.example.com.
    server_name $DOMAIN;
    root $SITE_PUBLIC;
    index index.php index.html index.htm;
    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;
    location / { try_files \$uri \$uri/ /index.php\$is_args\$args; }
    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:$SOCK;
    }
    location ~ /\.(?!well-known).* { deny all; }
}
EOF
    install -d -m 0700 -o root -g root "$SITES_STATE" "$SITES_TRASH"
    printf 'domain=%s\npath=%s\nuser=%s\ndevice=%s\ninode=%s\n' \
      "$DOMAIN" "$SITE_PUBLIC" "$SITE_USER" "$(stat -c %d "$SITE_PUBLIC")" "$(stat -c %i "$SITE_PUBLIC")" \
      > "$SITE_STATE"
    chmod 0600 "$SITE_STATE"
    ln -sf "$NGINX_AV/$DOMAIN" "$NGINX_EN/$DOMAIN"
    if ! "/usr/sbin/php-fpm${PHPVER}" -t >/dev/null 2>&1 || ! nginx -t; then
      rm -f "$NGINX_EN/$DOMAIN" "$NGINX_AV/$DOMAIN" "$FPM_DIR/nebula-site-${SITE_ID}.conf" "$SITE_STATE"
      userdel "$SITE_USER" >/dev/null 2>&1 || true
      rmdir "$SITE_PUBLIC" "$SITE_BASE" >/dev/null 2>&1 || true
      die "PHP-FPM or nginx rejected the website configuration"
    fi
    systemctl reload nginx
    # The panel request may itself be running on this PHP version. Defer the
    # FPM reload until after its JSON response has reached the browser.
    schedule_php_service reload "$PHPVER"
    echo "created $SITE_ID $DOMAIN -> $SITE_PUBLIC (PHP $PHPVER)"
    ;;

  # Discover simple per-domain Nginx vhosts managed in the same layout Nebula
  # creates. Output: id<TAB>domain<TAB>docroot<TAB>php-version<TAB>ssl-state.
  site-list)
    shopt -s nullglob
    for CONF in "$NGINX_AV"/*; do
      [[ -f "$CONF" ]] || continue
      DOMAIN="$(basename "$CONF")"
      [[ "$DOMAIN" == "default" || "$DOMAIN" == "nebula" ]] && continue
      [[ "$DOMAIN" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]{0,251}[a-zA-Z0-9])?$ ]] || continue
      SERVER_NAME="$(awk '/^[[:space:]]*server_name[[:space:]]+/ {gsub(/;/, "", $2); print $2; exit}' "$CONF")"
      [[ "$SERVER_NAME" == "$DOMAIN" ]] || continue
      SITE_ID="$(sed -nE 's/^# Managed by Nebula Panel\. Site ID: ([a-f0-9]{32})$/\1/p' "$CONF" | head -1)"
      [[ "$SITE_ID" =~ ^[a-f0-9]{32}$ ]] || continue
      DOCROOT="$(awk '/^[[:space:]]*root[[:space:]]+/ {gsub(/;/, "", $2); print $2; exit}' "$CONF")"
      [[ "$DOCROOT" == "$SITES_ROOT/$SITE_ID/public" ]] || continue
      PHPVER="$(grep -l "listen = /run/php/nebula-site-${SITE_ID}.sock" /etc/php/*/fpm/pool.d/nebula-site-"${SITE_ID}".conf 2>/dev/null \
        | awk -F/ 'NR==1 {print $4}')"
      [[ -n "$PHPVER" ]] || PHPVER=""
      SSL=no; grep -qE '^[[:space:]]*ssl_certificate[[:space:]]' "$CONF" && SSL=yes
      printf '%s\t%s\t%s\t%s\t%s\n' "$SITE_ID" "$DOMAIN" "$DOCROOT" "$PHPVER" "$SSL"
    done
    ;;

  # Change the PHP-FPM socket used by an existing Nebula Nginx vhost.
  site-php)
    SITE_ID="${1:-}"; DOMAIN="${2:-}"; PHPVER="${3:-}"
    valid_site_id "$SITE_ID"; valid_domain "$DOMAIN"; valid_php "$PHPVER"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID" "$DOMAIN"
    CONF="$NGINX_AV/$DOMAIN"; SOCK="/run/php/nebula-site-${SITE_ID}.sock"
    [[ -f "$CONF" ]] || die "website config not found"
    TARGET_DIR="/etc/php/${PHPVER}/fpm/pool.d"; [[ -d "$TARGET_DIR" ]] || die "PHP-FPM $PHPVER not installed"
    OLD_POOL="$(grep -l "listen = $SOCK" /etc/php/*/fpm/pool.d/nebula-site-"${SITE_ID}".conf 2>/dev/null | head -1)"
    [[ -n "$OLD_POOL" ]] || die "managed site pool not found"
    OLD_VER="$(awk -F/ '{print $4}' <<<"$OLD_POOL")"
    cp "$OLD_POOL" "$TARGET_DIR/nebula-site-${SITE_ID}.conf"
    if [[ "$OLD_POOL" != "$TARGET_DIR/nebula-site-${SITE_ID}.conf" ]]; then rm -f "$OLD_POOL"; fi
    schedule_php_service reload "$PHPVER"
    [[ "$OLD_VER" == "$PHPVER" ]] || schedule_php_service reload "$OLD_VER"
    echo "updated $DOMAIN to PHP $PHPVER"
    ;;

  # site-stats <site-id> -> bytes<TAB>files.
  # sites with restrictive ownership are still measured accurately.
  site-stats)
    SITE_ID="${1:-}"; site_state_check "$SITE_ID"
    BYTES="$(du -sb -- "$SITE_PUBLIC" 2>/dev/null | awk '{print $1}')"
    FILES="$(find "$SITE_PUBLIC" -xdev -type f 2>/dev/null | wc -l | tr -d ' ')"
    printf '%s\t%s\n' "${BYTES:-0}" "${FILES:-0}"
    ;;

  # site-backup <site-id> <archive-name>
  site-backup)
    SITE_ID="${1:-}"; ARCHIVE_NAME="${2:-}"
    valid_site_id "$SITE_ID"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID"
    [[ "$ARCHIVE_NAME" =~ ^[A-Za-z0-9_.-]{1,100}-[0-9]{8}-[0-9]{6}\.tar\.gz$ ]] || die "invalid archive name"
    [[ -r "$PANEL_ROOT_FILE" ]] || die "panel root is not configured"
    PANEL_ROOT="$(realpath "$(head -n 1 "$PANEL_ROOT_FILE")")"
    BACKUP_DIR="$PANEL_ROOT/data/backups"
    [[ "$BACKUP_DIR" == "$PANEL_ROOT/data/backups" ]] || die "invalid backup directory"
    install -d -m 0700 "$BACKUP_DIR"
    DEST="$BACKUP_DIR/$ARCHIVE_NAME"; [[ ! -e "$DEST" ]] || die "backup already exists"
    FREE="$(df -P "$BACKUP_DIR" | awk 'NR==2 {print $4 * 1024}')"
    USED="$(du -sb "$SITE_BASE" | awk '{print $1}')"
    [[ "${FREE:-0}" -gt $(( ${USED:-0} + 16777216 )) ]] || die "insufficient free disk space"
    TMP="$BACKUP_DIR/.${ARCHIVE_NAME}.tmp"
    trap 'rm -f "$TMP"' EXIT
    tar --one-file-system --numeric-owner -czf "$TMP" -C "$SITE_BASE" public
    gzip -t "$TMP"
    mv "$TMP" "$DEST"
    PANEL_USER="$(stat -c %U "$PANEL_ROOT/data")"
    chown "$PANEL_USER:$PANEL_USER" "$DEST"; chmod 0600 "$DEST"
    echo "sha256=$(sha256sum "$DEST" | awk '{print $1}')"
    echo "bytes=$(stat -c %s "$DEST")"
    echo "entries=$(tar -tzf "$DEST" | wc -l | tr -d ' ')"
    ;;

  site-git-status)
    SITE_ID="${1:-}"; site_state_check "$SITE_ID"
    [[ -d "$SITE_PUBLIC/.git" ]] || { echo "connected=no"; exit 0; }
    echo "connected=yes"
    printf 'branch='; runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" rev-parse --abbrev-ref HEAD 2>/dev/null || true
    printf 'remote='; runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" config --get remote.origin.url 2>/dev/null || true
    printf 'commit='; runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" rev-parse --short HEAD 2>/dev/null || true
    if [[ -n "$(runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" status --porcelain 2>/dev/null)" ]]; then echo "dirty=yes"; else echo "dirty=no"; fi
    ;;

  site-git-connect)
    SITE_ID="${1:-}"; URL="${2:-}"; BRANCH="${3:-}"
    valid_site_id "$SITE_ID"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID"
    [[ "$URL" =~ ^https://[A-Za-z0-9._-]+(:[0-9]+)?/[A-Za-z0-9._~/-]+(\.git)?$ ]] \
      || die "only credential-free HTTPS repository URLs are allowed"
    [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ && "$BRANCH" != *".."* && "$BRANCH" != -* ]] || die "invalid branch"
    runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" init -q
    runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" remote remove origin >/dev/null 2>&1 || true
    runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" remote add origin "$URL"
    runuser -u "$SITE_USER" -- env GIT_TERMINAL_PROMPT=0 git -C "$SITE_PUBLIC" fetch --depth 1 origin "$BRANCH"
    runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" checkout -f -B "$BRANCH" "origin/$BRANCH"
    ;;

  site-git-pull)
    SITE_ID="${1:-}"; BRANCH="${2:-}"
    valid_site_id "$SITE_ID"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID"
    [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ && "$BRANCH" != *".."* && "$BRANCH" != -* ]] || die "invalid branch"
    [[ -d "$SITE_PUBLIC/.git" && ! -L "$SITE_PUBLIC/.git" ]] || die "repository is not connected"
    runuser -u "$SITE_USER" -- env GIT_TERMINAL_PROMPT=0 git -C "$SITE_PUBLIC" fetch --depth 1 origin "$BRANCH"
    runuser -u "$SITE_USER" -- git -C "$SITE_PUBLIC" reset --hard "origin/$BRANCH"
    ;;

  site-git-disconnect)
    SITE_ID="${1:-}"
    valid_site_id "$SITE_ID"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID"
    [[ -d "$SITE_PUBLIC/.git" && ! -L "$SITE_PUBLIC/.git" ]] && rm -rf --one-file-system "$SITE_PUBLIC/.git"
    ;;

  # site-delete <site-id> <domain> [archive]
  site-delete)
    SITE_ID="${1:-}"; DOMAIN="${2:-}"; PURGE="${3:-no}"
    valid_site_id "$SITE_ID"; valid_domain "$DOMAIN"
    exec 8>"/run/lock/nebula-site-${SITE_ID}.lock"
    flock -w 30 8 || die "another operation is running for this site"
    site_state_check "$SITE_ID" "$DOMAIN"
    CONF_BACKUP="$(mktemp)"; trap 'rm -f "$CONF_BACKUP"' EXIT
    cp "$NGINX_AV/$DOMAIN" "$CONF_BACKUP"
    rm -f "$NGINX_EN/$DOMAIN" "$NGINX_AV/$DOMAIN"
    if ! nginx -t || ! systemctl reload nginx; then
      install -m 0644 -o root -g root "$CONF_BACKUP" "$NGINX_AV/$DOMAIN"
      ln -sf "$NGINX_AV/$DOMAIN" "$NGINX_EN/$DOMAIN"
      systemctl reload nginx >/dev/null 2>&1 || true
      die "nginx rejected site removal; previous configuration restored"
    fi
    for POOL in /etc/php/*/fpm/pool.d/nebula-site-"${SITE_ID}".conf; do
      [[ -f "$POOL" ]] || continue
      VER="$(awk -F/ '{print $4}' <<<"$POOL")"; rm -f "$POOL"; schedule_php_service reload "$VER"
    done
    if [[ "$PURGE" == "archive" ]]; then
      ARCHIVE="$SITES_TRASH/${SITE_ID}-$(date +%Y%m%d-%H%M%S)"
      mv -- "$SITE_BASE" "$ARCHIVE"
      chown -R root:root "$ARCHIVE"
      # Remove other server-side traces of the site so nothing is left behind.
      rm -rf "/etc/nebula-panel/certs/$DOMAIN"
      rm -f "/var/log/nginx/${DOMAIN}.access.log" "/var/log/nginx/${DOMAIN}.error.log" \
            /var/log/nginx/${DOMAIN}.access.log.* /var/log/nginx/${DOMAIN}.error.log.* 2>/dev/null || true
      rm -f "$SITE_STATE"
      userdel "$SITE_USER" >/dev/null 2>&1 || true
    fi
    echo "deleted $DOMAIN"
    ;;

  # site-ssl <domain> [email]
  site-ssl)
    DOMAIN="${1:-}"; EMAIL="${2:-}"
    valid_domain "$DOMAIN"; valid_email "$EMAIL"
    command -v certbot >/dev/null || die "certbot not installed"
    if [[ -n "$EMAIL" ]]; then
      certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos -m "$EMAIL" --redirect
    else
      certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos --register-unsafely-without-email --redirect
    fi
    echo "ssl issued for $DOMAIN"
    ;;

  # php-install <version>  (adds ondrej/php PPA on Ubuntu, installs php<ver>-fpm + common extensions)
  php-install)
    VER="${1:-}"
    case "$VER" in 8.2|8.3|8.4|8.5) ;; *) die "unsupported php version" ;; esac
    export DEBIAN_FRONTEND=noninteractive
    if ! command -v add-apt-repository >/dev/null 2>&1; then
        apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
        apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y software-properties-common
    fi
    if ! grep -rqs 'ondrej/php' /etc/apt/sources.list.d 2>/dev/null; then
      add-apt-repository -y ppa:ondrej/php
    fi
    # Stop the ondrej/php PPA from hijacking the system-default (unversioned)
    # php meta-packages. The base install ships `php-fpm`, `php-cli`, … which
    # track "the default PHP version"; once this PPA is added that default
    # becomes ondrej's newest *stable* (e.g. 8.4). Without this pin, asking for
    # 8.5 also drags in 8.4 through those metas, and the updater then perpetually
    # tries to pull/keep-back a second PHP. Pinning the ondrej candidate for the
    # unversioned metas to -1 leaves them on the distro's version, while the
    # explicitly versioned "php8.5-*" packages below still come from the PPA.
    PIN=/etc/apt/preferences.d/nebula-ondrej-php
    cat > "$PIN" <<'PINEOF'
# Managed by Nebula Panel. Keeps unversioned php meta-packages on the distro
# default so adding extra PHP versions never pulls in another one.
Package: php php-fpm php-cli php-mysql php-curl php-mbstring php-xml php-zip php-gd php-bcmath php-intl php-soap php-imap php-json php-opcache php-dev php-pear php-readline php-redis php-imagick php-xdebug php-memcached php-apcu
Pin: release o=LP-PPA-ondrej-php
Pin-Priority: -1
PINEOF
    chmod 0644 "$PIN"
      apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
      apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y "php${VER}-fpm" "php${VER}-cli" "php${VER}-mysql" "php${VER}-curl" \
      "php${VER}-mbstring" "php${VER}-xml" "php${VER}-gd" "php${VER}-zip" \
      || die "apt install failed for php ${VER}"
    systemctl enable --now "php${VER}-fpm" || true
    echo "installed php ${VER}"
    ;;

  # php-extension <install|enable|disable> <version> <extension>
  php-extension)
    ACTION="${1:-}"; VER="${2:-}"; EXTENSION="${3:-}"
    valid_php "$VER"
    case "$ACTION" in install|enable|disable) ;; *) die "invalid extension action" ;; esac
    case "$EXTENSION" in curl|mbstring|xml|gd|zip|mysql|intl|bcmath|soap|imagick|redis|xdebug|imap|opcache) ;;
      *) die "extension is not managed" ;;
    esac
    PACKAGE="php${VER}-${EXTENSION}"
    if [[ "$ACTION" == "install" ]]; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
      apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y "$PACKAGE" || die "extension install failed"
    else
      MODULES=("$EXTENSION")
      case "$EXTENSION" in
        mysql) MODULES=(mysqlnd mysqli pdo_mysql) ;;
        xml) MODULES=(dom simplexml xml xmlreader xmlwriter xsl) ;;
      esac
      for MODULE in "${MODULES[@]}"; do
        [[ -f "/etc/php/$VER/mods-available/$MODULE.ini" ]] || continue
        if [[ "$ACTION" == "enable" ]]; then phpenmod -v "$VER" -s ALL "$MODULE"
        else phpdismod -v "$VER" -s ALL "$MODULE"; fi
      done
    fi
    schedule_php_service reload "$VER"
    echo "$ACTION complete for PHP $VER $EXTENSION"
    ;;

  # Restart one or every running PHP-FPM version without dropping this request.
  php-restart)
    VER="${1:-}"
    if [[ "$VER" == "all" ]]; then
      FOUND=0
      for SOCK in /run/php/php*-fpm.sock; do
        [[ -S "$SOCK" ]] || continue
        ITEM="$(basename "$SOCK" | sed -E 's/php([0-9.]+)-fpm\.sock/\1/')"
        valid_php "$ITEM"; schedule_php_service restart "$ITEM"; FOUND=1
      done
      [[ "$FOUND" == 1 ]] || die "no running PHP-FPM pools found"
    else
      valid_php "$VER"; schedule_php_service restart "$VER"
    fi
    echo "PHP-FPM restart scheduled"
    ;;

  # Replace/restore the FPM php.ini after decoding and validating a bounded
  # payload. A single previous version is retained for the Revert action.
  php-ini-replace)
    VER="${1:-}"; INI_B64="${2:-}"; valid_php "$VER"
    [[ "$INI_B64" =~ ^[A-Za-z0-9+/=]+$ && "${#INI_B64}" -le 500000 ]] || die "invalid or oversized php.ini payload"
    INI="/etc/php/$VER/fpm/php.ini"; [[ -f "$INI" ]] || die "FPM php.ini not found"
    TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
    printf '%s' "$INI_B64" | base64 -d > "$TMP" 2>/dev/null || die "invalid php.ini encoding"
    [[ -s "$TMP" && "$(wc -c < "$TMP")" -le 350000 ]] || die "php.ini is empty or too large"
    CHECK="$("php$VER" -c "$TMP" -r 'exit(0);' 2>&1)" || die "php.ini validation failed: $CHECK"
    [[ "$CHECK" != *"syntax error"* ]] || die "php.ini validation failed: $CHECK"
    cp "$INI" "$INI.nebula-backup"
    chown --reference="$INI" "$INI.nebula-backup" 2>/dev/null || true
    chmod --reference="$INI" "$INI.nebula-backup" 2>/dev/null || true
    install -m 0644 -o root -g root "$TMP" "$INI"
    schedule_php_service reload "$VER"
    echo "php.ini saved; reload scheduled"
    ;;

  php-ini-restore)
    VER="${1:-}"; valid_php "$VER"
    INI="/etc/php/$VER/fpm/php.ini"; BACKUP="$INI.nebula-backup"
    [[ -f "$INI" && -f "$BACKUP" ]] || die "no php.ini backup is available"
    TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT; cp "$INI" "$TMP"
    install -m 0644 -o root -g root "$BACKUP" "$INI"
    install -m 0644 -o root -g root "$TMP" "$BACKUP"
    schedule_php_service reload "$VER"
    echo "php.ini restored; reload scheduled"
    ;;

  composer-install)
    command -v composer >/dev/null 2>&1 && die "Composer is already installed"
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y composer || die "Composer installation failed"
    echo "Composer installed"
    ;;

  # ---- Fail2Ban -----------------------------------------------------------
  # Read-only status plus ban/unban. fail2ban-client needs root, so the panel
  # goes through the helper rather than a broad sudo grant.

  # f2b-status  ->  key=value header, then one TAB-separated row per jail:
  #   jail<TAB>name<TAB>currently_failed<TAB>total_failed<TAB>currently_banned<TAB>total_banned<TAB>ip,ip,…<TAB>logfiles
  f2b-status)
    if ! command -v fail2ban-client >/dev/null 2>&1; then
      echo "installed=no"; echo "active=inactive"; exit 0
    fi
    echo "installed=yes"
    echo "active=$(systemctl is-active fail2ban 2>/dev/null || echo inactive)"
    echo "enabled=$(systemctl is-enabled fail2ban 2>/dev/null || echo unknown)"
    echo "version=$(fail2ban-client --version 2>/dev/null | head -n1 | awk '{print $2}' | sed 's/^v//')"
    PING="$(fail2ban-client ping 2>&1 || true)"
    case "$PING" in *pong*) echo "server=up" ;; *) echo "server=down"; echo "server_error=${PING//$'\n'/ }" ;; esac
    JAILS="$(fail2ban-client status 2>/dev/null | sed -n 's/^.*Jail list:[[:space:]]*//p' | tr -d ' ')"
    echo "jails=${JAILS:-}"
    IFS=',' read -r -a JLIST <<<"${JAILS:-}"
    for J in "${JLIST[@]}"; do
      [[ -n "$J" ]] || continue
      S="$(fail2ban-client status "$J" 2>/dev/null || true)"
      [[ -n "$S" ]] || continue
      f() { printf '%s\n' "$S" | sed -n "s/.*$1:[[:space:]]*//p" | head -n1 | sed 's/[[:space:]]*$//'; }
      CF="$(f 'Currently failed')"; TF="$(f 'Total failed')"
      CB="$(f 'Currently banned')"; TB="$(f 'Total banned')"
      IPS="$(f 'Banned IP list')"; LOGS="$(f 'File list')"
      printf 'jail\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$J" "${CF:-0}" "${TF:-0}" "${CB:-0}" "${TB:-0}" "$(printf '%s' "$IPS" | tr -s ' ' ',')" "$LOGS"
    done
    ;;

  # f2b-jail <jail>  ->  raw `fail2ban-client status <jail>` output.
  f2b-jail)
    JAIL="${1:-}"
    [[ "$JAIL" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || die "invalid jail name"
    command -v fail2ban-client >/dev/null 2>&1 || die "fail2ban is not installed"
    fail2ban-client status "$JAIL" 2>&1 || die "no such jail"
    ;;

  # f2b-unban <jail> <ip> | f2b-ban <jail> <ip>
  f2b-unban|f2b-ban)
    JAIL="${1:-}"; IP="${2:-}"
    [[ "$JAIL" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || die "invalid jail name"
    [[ "$IP" =~ ^[0-9a-fA-F:.]{3,45}$ ]] || die "invalid IP address"
    command -v fail2ban-client >/dev/null 2>&1 || die "fail2ban is not installed"
    ACT="${CMD#f2b-}"
    fail2ban-client set "$JAIL" "${ACT}ip" "$IP" 2>&1 || die "fail2ban-client ${ACT} failed"
    echo "${ACT}ned $IP in $JAIL"
    ;;

  # f2b-log [lines]  ->  recent fail2ban activity (bans, unbans, findings).
  f2b-log)
    LINES="${1:-200}"
    [[ "$LINES" =~ ^[0-9]{1,4}$ ]] || die "invalid line count"
    { [[ -f /var/log/fail2ban.log ]] && tail -n "$LINES" /var/log/fail2ban.log; } 2>/dev/null \
      || journalctl -u fail2ban -n "$LINES" --no-pager 2>/dev/null \
      || echo "no fail2ban log available"
    ;;

  # ---- ModSecurity (nginx WAF) --------------------------------------------
  # The panel owns exactly two files: $MODSEC_DIR (rule entrypoint + tuned base
  # config) and $MODSEC_ENABLE in conf.d, which nginx already includes at http
  # level. Everything else comes from the distro packages.

  # modsec-status  ->  key=value lines.
  modsec-status)
    echo "installed=$([[ -n "$(ls /etc/nginx/modules-enabled/*modsecurity*.conf 2>/dev/null)" ]] && echo yes || echo no)"
    echo "package=$(dpkg-query -W -f='${Status}' libnginx-mod-http-modsecurity 2>/dev/null | grep -q 'ok installed' && echo yes || echo no)"
    echo "crs=$(dpkg-query -W -f='${Status}' modsecurity-crs 2>/dev/null | grep -q 'ok installed' && echo yes || echo no)"
    echo "enabled=$([[ -f "$MODSEC_ENABLE" ]] && echo yes || echo no)"
    MODE=unknown
    if [[ -f "$MODSEC_CONF" ]]; then
      MODE="$(sed -n 's/^[[:space:]]*SecRuleEngine[[:space:]]\+\([A-Za-z]\+\).*/\1/p' "$MODSEC_CONF" | tail -n1)"
      MODE="${MODE:-unknown}"
    fi
    echo "mode=$MODE"
    echo "rules_file=$MODSEC_MAIN"
    echo "config_file=$MODSEC_CONF"
    echo "audit_log=$MODSEC_AUDIT"
    echo "nginx=$(systemctl is-active nginx 2>/dev/null || echo inactive)"
    if [[ -f "$MODSEC_AUDIT" ]]; then
      echo "audit_events=$(grep -c 'ModSecurity' "$MODSEC_AUDIT" 2>/dev/null || echo 0)"
    else
      echo "audit_events=0"
    fi
    if [[ -f /var/log/nginx/error.log ]]; then
      echo "denied_recent=$(tail -n 2000 /var/log/nginx/error.log 2>/dev/null | grep -c 'ModSecurity.*Access denied' || echo 0)"
    else
      echo "denied_recent=0"
    fi
    ;;

  # modsec-install  — install the nginx connector + OWASP CRS and switch it on.
  modsec-install)
    command -v nginx >/dev/null 2>&1 || die "nginx is not installed — ModSecurity is wired into nginx"
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update || true
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y libnginx-mod-http-modsecurity modsecurity-crs \
      || die "apt could not install libnginx-mod-http-modsecurity / modsecurity-crs from this system's sources"

    mkdir -p "$MODSEC_DIR"
    chmod 0755 "$MODSEC_DIR"
    CONF_WAS_PRESENT=no
    [[ -f "$MODSEC_CONF" ]] && CONF_WAS_PRESENT=yes
    [[ -f "$MODSEC_MAIN" ]] && cp "$MODSEC_MAIN" "$MODSEC_MAIN.nebula-bak"
    [[ -f "$MODSEC_ENABLE" ]] && cp "$MODSEC_ENABLE" "$MODSEC_ENABLE.nebula-bak"
    if [[ ! -f "$MODSEC_CONF" ]]; then
      RECOMMENDED=""
      for CANDIDATE in /etc/nginx/modsecurity.conf-recommended \
                       /etc/modsecurity/modsecurity.conf-recommended \
                       /etc/modsecurity/modsecurity.conf \
                       /usr/share/modsecurity/modsecurity.conf-recommended; do
        [[ -f "$CANDIDATE" ]] && { RECOMMENDED="$CANDIDATE"; break; }
      done
      if [[ -n "$RECOMMENDED" ]]; then
        cp "$RECOMMENDED" "$MODSEC_CONF"
        echo "-- base config from $RECOMMENDED"
      else
        cat > "$MODSEC_CONF" <<'MSEOF'
# Managed by Nebula Panel — minimal ModSecurity base configuration.
SecRuleEngine DetectionOnly
SecRequestBodyAccess On
SecRequestBodyLimit 13107200
SecRequestBodyNoFilesLimit 131072
SecRequestBodyLimitAction Reject
SecResponseBodyAccess Off
SecTmpDir /tmp/
SecDataDir /tmp/
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial
SecAuditLog /var/log/nginx/modsec_audit.log
MSEOF
        echo "-- base config written by the panel (no distro template found)"
      fi
      # Start in DetectionOnly so a fresh install cannot take a live site down;
      # the panel's Security page switches it to On once traffic looks clean.
      sed -i 's|^[[:space:]]*SecRuleEngine[[:space:]].*|SecRuleEngine DetectionOnly|' "$MODSEC_CONF"
      grep -q '^[[:space:]]*SecRuleEngine' "$MODSEC_CONF" || echo "SecRuleEngine DetectionOnly" >> "$MODSEC_CONF"
      sed -i "s|^[[:space:]]*SecAuditLog[[:space:]]\+/.*|SecAuditLog $MODSEC_AUDIT|" "$MODSEC_CONF"
      grep -q '^[[:space:]]*SecAuditLog[[:space:]]\+/' "$MODSEC_CONF" || echo "SecAuditLog $MODSEC_AUDIT" >> "$MODSEC_CONF"
      chmod 0644 "$MODSEC_CONF"
    fi

    # owasp-crs.load belongs to Apache and contains IncludeOptional directives
    # that the Nginx libmodsecurity parser does not understand.
    CRS_SETUP=""
    for CANDIDATE in /etc/modsecurity/crs/crs-setup.conf \
                     /usr/share/modsecurity-crs/crs-setup.conf; do
      [[ -f "$CANDIDATE" ]] && { CRS_SETUP="$CANDIDATE"; break; }
    done
    CRS_RULES=/usr/share/modsecurity-crs/rules
    if [[ -z "$CRS_SETUP" || ! -d "$CRS_RULES" ]]; then
      [[ -f "$MODSEC_MAIN.nebula-bak" ]] && mv "$MODSEC_MAIN.nebula-bak" "$MODSEC_MAIN"
      [[ "$CONF_WAS_PRESENT" == yes ]] || rm -f "$MODSEC_CONF"
      die "the installed OWASP CRS package has no usable setup or rules directory"
    fi

    # Rule entrypoint: our base config, then the OWASP Core Rule Set. Package
    # layouts differ between releases, so probe for whichever one is present.
    {
      echo "# Managed by Nebula Panel — ModSecurity rule entrypoint."
      echo "Include $MODSEC_CONF"
      if [[ -n "$CRS_SETUP" && -d "$CRS_RULES" ]]; then
        echo "Include $CRS_SETUP"
        [[ -f /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf ]] \
          && echo "Include /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf"
        echo "Include $CRS_RULES/*.conf"
        [[ -f /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf ]] \
          && echo "Include /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf"
      else
        echo "# OWASP CRS not found — base rules only."
      fi
    } > "$MODSEC_MAIN"
    chmod 0644 "$MODSEC_MAIN"

    cat > "$MODSEC_ENABLE" <<EOF
# Managed by Nebula Panel. Enables ModSecurity for every nginx server block.
modsecurity on;
modsecurity_rules_file $MODSEC_MAIN;
EOF
    chmod 0644 "$MODSEC_ENABLE"

    if ! NGINX_TEST="$(nginx -t 2>&1)"; then
      if [[ -f "$MODSEC_ENABLE.nebula-bak" ]]; then
        mv "$MODSEC_ENABLE.nebula-bak" "$MODSEC_ENABLE"
      else
        rm -f "$MODSEC_ENABLE"
      fi
      [[ -f "$MODSEC_MAIN.nebula-bak" ]] && mv "$MODSEC_MAIN.nebula-bak" "$MODSEC_MAIN"
      [[ "$CONF_WAS_PRESENT" == yes ]] || rm -f "$MODSEC_CONF"
      echo "$NGINX_TEST" >&2
      die "nginx rejected the ModSecurity configuration; the previous configuration was restored"
    fi
    rm -f "$MODSEC_ENABLE.nebula-bak" "$MODSEC_MAIN.nebula-bak"
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null \
      || die "nginx configuration is valid, but nginx could not be reloaded"
    echo "ModSecurity enabled in DetectionOnly mode (logging, not blocking)"
    ;;

  # modsec-uninstall  — disable in nginx first, then remove the packages.
  modsec-uninstall)
    rm -f "$MODSEC_ENABLE"
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
      systemctl reload nginx 2>/dev/null || true
    fi
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 remove -y libnginx-mod-http-modsecurity || true
    if command -v nginx >/dev/null 2>&1; then
      nginx -t >/dev/null 2>&1 && { systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true; }
    fi
    echo "ModSecurity disabled and removed ($MODSEC_DIR kept for its tuned rules)"
    ;;

  # modsec-mode <On|DetectionOnly|Off>
  modsec-mode)
    MODE="${1:-}"
    case "$MODE" in On|DetectionOnly|Off) ;; *) die "invalid ModSecurity mode" ;; esac
    command -v nginx >/dev/null 2>&1 || die "nginx is not installed"
    [[ -f "$MODSEC_CONF" ]] || die "ModSecurity is not configured on this server"
    cp "$MODSEC_CONF" "$MODSEC_CONF.nebula-bak"
    sed -i "s|^[[:space:]]*SecRuleEngine[[:space:]].*|SecRuleEngine $MODE|" "$MODSEC_CONF"
    grep -q "^SecRuleEngine $MODE" "$MODSEC_CONF" || echo "SecRuleEngine $MODE" >> "$MODSEC_CONF"
    if ! NGINX_TEST="$(nginx -t 2>&1)"; then
      mv "$MODSEC_CONF.nebula-bak" "$MODSEC_CONF"
      echo "$NGINX_TEST" >&2
      die "nginx rejected the change — the previous configuration was restored"
    fi
    rm -f "$MODSEC_CONF.nebula-bak"
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
    echo "SecRuleEngine set to $MODE"
    ;;

  # modsec-log [lines]  ->  recent ModSecurity findings from nginx's error log.
  modsec-log)
    LINES="${1:-200}"
    [[ "$LINES" =~ ^[0-9]{1,4}$ ]] || die "invalid line count"
    FOUND=""
    if [[ -f /var/log/nginx/error.log ]]; then
      OUT="$(grep -h 'ModSecurity' /var/log/nginx/error.log 2>/dev/null | tail -n "$LINES" || true)"
      [[ -n "$OUT" ]] && { printf '%s\n' "$OUT"; FOUND=yes; }
    fi
    if [[ -z "$FOUND" && -f "$MODSEC_AUDIT" ]]; then
      tail -n "$LINES" "$MODSEC_AUDIT" 2>/dev/null && FOUND=yes
    fi
    [[ -n "$FOUND" ]] || echo "no ModSecurity events logged yet"
    ;;

  # compose-install  — install Docker Compose.
  # Ubuntu's docker.io package ships WITHOUT the compose CLI plugin, which is why
  # a working Docker install can still report "Docker Compose is not available".
  # Package names differ across releases, so try each in turn and verify.
  compose-install)
    command -v docker >/dev/null 2>&1 || die "Docker is not installed"
    if docker compose version >/dev/null 2>&1; then
      echo "docker compose is already available"; exit 0
    fi
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update || true
    INSTALLED=""
    for PKG in docker-compose-v2 docker-compose-plugin docker-compose; do
      echo "-- trying $PKG"
      if apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y "$PKG"; then
        INSTALLED="$PKG"
        # Stop as soon as one of them actually provides a usable compose.
        if docker compose version >/dev/null 2>&1 || command -v docker-compose >/dev/null 2>&1; then
          break
        fi
      fi
    done
    [[ -n "$INSTALLED" ]] || die "no Docker Compose package could be installed from this system's apt sources"
    if docker compose version >/dev/null 2>&1; then
      echo "installed $INSTALLED -> $(docker compose version)"
    elif command -v docker-compose >/dev/null 2>&1; then
      echo "installed $INSTALLED -> $(docker-compose version | head -n 1)"
      echo "note: standalone docker-compose binary (v1-style CLI)"
    else
      die "installed $INSTALLED but Compose still is not runnable"
    fi
    ;;

  # pma-install <targetdir>
  pma-install)
    TARGET="${1:-}"
    valid_path "$TARGET"
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y phpmyadmin \
      || die "distribution-verified phpMyAdmin package install failed"
    SRC=/usr/share/phpmyadmin
    [[ -f "$SRC/index.php" ]] || die "phpMyAdmin package layout unexpected"
    mkdir -p "$TARGET"
    cp -aL "$SRC"/. "$TARGET"/
    # Avoid an infinite producer piped into head: with pipefail, head closing
    # the pipe makes tr exit on SIGPIPE and aborts an otherwise good install.
    SECRET="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    sed "s|\$cfg\['blowfish_secret'\] = '';|\$cfg['blowfish_secret'] = '${SECRET}';|" \
      "$TARGET/config.sample.inc.php" > "$TARGET/config.inc.php"
    mkdir -p "$TARGET/tmp"
    chown -R nebula-webapps:nebula-webapps "$TARGET"
    chmod 700 "$TARGET/tmp"
    echo "phpMyAdmin installed at $TARGET"
    ;;

  # pma-remove <targetdir>
  pma-remove)
    TARGET="${1:-}"
    valid_path "$TARGET"
    [[ "$TARGET" == "/" || "$TARGET" == "/var/www" ]] && die "refusing"
    [[ -f "$TARGET/config.inc.php" ]] || die "not a phpMyAdmin dir"
    rm -rf "$TARGET"
    echo "removed $TARGET"
    ;;

  # Configure phpMyAdmin's documented signon authentication mode. The panel
  # creates the short-lived signed launch URL and writes credentials only to a
  # dedicated server-side PHP session; no database password appears in a URL.
  pma-signon)
    TARGET="${1:-}"; SIGNON_URL="${2:-}"
    valid_path "$TARGET"
    [[ "$SIGNON_URL" =~ ^https?://[A-Za-z0-9._:/?=%-]+$ ]] || die "invalid signon URL"
    LOGOUT_URL="${SIGNON_URL/pma-signon/databases}"
    COOKIE_SECURE=false; [[ "$SIGNON_URL" == https://* ]] && COOKIE_SECURE=true
    CONFIG="$TARGET/config.inc.php"
    [[ -f "$CONFIG" ]] || die "phpMyAdmin config not found"
    if ! grep -q 'NEBULA_SIGNON' "$CONFIG"; then
      cat >> "$CONFIG" <<EOF

/* NEBULA_SIGNON: managed by Nebula Panel */
\$cfg['Servers'][\$i]['auth_type'] = 'signon';
\$cfg['Servers'][\$i]['SignonSession'] = 'NebulaPmaSignon';
\$cfg['Servers'][\$i]['SignonCookieParams'] = ['lifetime' => 0, 'path' => '/', 'domain' => '', 'secure' => $COOKIE_SECURE, 'httponly' => true, 'samesite' => 'Lax'];
\$cfg['Servers'][\$i]['SignonURL'] = '$SIGNON_URL';
\$cfg['Servers'][\$i]['LogoutURL'] = '$LOGOUT_URL';
EOF
    fi
    echo "phpMyAdmin signon enabled"
    ;;

  # cert-list  -> raw `certbot certificates` output (parsed by the panel)
  cert-list)
    command -v certbot >/dev/null || die "certbot not installed"
    certbot certificates 2>/dev/null
    ;;

  # cert-renew [name]  -> renew all, or one certificate by name
  cert-renew)
    NAME="${1:-}"
    command -v certbot >/dev/null || die "certbot not installed"
    if [[ -n "$NAME" ]]; then
      valid_domain "$NAME"
      certbot renew --cert-name "$NAME" --non-interactive
    else
      certbot renew --non-interactive
    fi
    echo "renew complete"
    ;;

  # cert-delete <name>
  cert-delete)
    NAME="${1:-}"; valid_domain "$NAME"
    command -v certbot >/dev/null || die "certbot not installed"
    certbot delete --cert-name "$NAME" --non-interactive
    echo "deleted $NAME"
    ;;

  # cert-upload <domain> <cert-b64> <key-b64> [chain-b64]
  cert-upload)
    DOMAIN="${1:-}"; CERT_B64="${2:-}"; KEY_B64="${3:-}"; CHAIN_B64="${4:-}"
    valid_domain "$DOMAIN"
    [[ "$CERT_B64" =~ ^[A-Za-z0-9+/=]+$ && "$KEY_B64" =~ ^[A-Za-z0-9+/=]+$ ]] || die "invalid certificate encoding"
    [[ -z "$CHAIN_B64" || "$CHAIN_B64" =~ ^[A-Za-z0-9+/=]+$ ]] || die "invalid chain encoding"
    CONF="$NGINX_AV/$DOMAIN"; [[ -f "$CONF" ]] || die "website nginx config not found"
    if grep -qE '^[[:space:]]*ssl_certificate[[:space:]]' "$CONF" && ! grep -q 'NEBULA_CUSTOM_SSL_BEGIN' "$CONF"; then
      die "the website already has a non-Nebula certificate; remove it before uploading a replacement"
    fi
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    printf '%s' "$CERT_B64" | base64 -d > "$TMP/cert.pem" 2>/dev/null || die "invalid certificate data"
    printf '%s' "$KEY_B64" | base64 -d > "$TMP/key.pem" 2>/dev/null || die "invalid private key data"
    openssl x509 -in "$TMP/cert.pem" -noout >/dev/null 2>&1 || die "invalid X.509 certificate"
    openssl x509 -in "$TMP/cert.pem" -checkhost "$DOMAIN" -noout >/dev/null 2>&1 || die "certificate does not cover $DOMAIN"
    openssl pkey -in "$TMP/key.pem" -noout >/dev/null 2>&1 || die "invalid private key"
    CERT_PUB="$(openssl x509 -in "$TMP/cert.pem" -pubkey -noout | openssl sha256)"
    KEY_PUB="$(openssl pkey -in "$TMP/key.pem" -pubout | openssl sha256)"
    [[ "$CERT_PUB" == "$KEY_PUB" ]] || die "certificate and private key do not match"
    CERT_DIR="/etc/nebula-panel/certs/$DOMAIN"
    [[ -f "$CERT_DIR/fullchain.pem" ]] && cp "$CERT_DIR/fullchain.pem" "$TMP/old-fullchain.pem"
    [[ -f "$CERT_DIR/privkey.pem" ]] && cp "$CERT_DIR/privkey.pem" "$TMP/old-privkey.pem"
    install -d -m 0700 -o root -g root "$CERT_DIR"
    cp "$TMP/cert.pem" "$TMP/fullchain.pem"
    if [[ -n "$CHAIN_B64" ]]; then
      printf '%s' "$CHAIN_B64" | base64 -d > "$TMP/chain.pem" 2>/dev/null || die "invalid chain data"
      grep -q -- '-----BEGIN CERTIFICATE-----' "$TMP/chain.pem" || die "invalid certificate chain"
      printf '\n' >> "$TMP/fullchain.pem"; cat "$TMP/chain.pem" >> "$TMP/fullchain.pem"
    fi
    install -m 0644 -o root -g root "$TMP/fullchain.pem" "$CERT_DIR/fullchain.pem"
    install -m 0600 -o root -g root "$TMP/key.pem" "$CERT_DIR/privkey.pem"
    cp "$CONF" "$TMP/nginx.conf"
    sed -i '/# NEBULA_CUSTOM_SSL_BEGIN/,/# NEBULA_CUSTOM_SSL_END/d' "$CONF"
    awk -v cert="$CERT_DIR/fullchain.pem" -v key="$CERT_DIR/privkey.pem" '
      { print }
      !done && /^[[:space:]]*server[[:space:]]*\{/ {
        print "    # NEBULA_CUSTOM_SSL_BEGIN"
        print "    listen 443 ssl;"
        print "    listen [::]:443 ssl;"
        print "    ssl_certificate " cert ";"
        print "    ssl_certificate_key " key ";"
        print "    # NEBULA_CUSTOM_SSL_END"
        done=1
      }
    ' "$CONF" > "$TMP/new.conf"
    install -m 0644 -o root -g root "$TMP/new.conf" "$CONF"
    if ! nginx -t >/dev/null 2>&1; then
      install -m 0644 -o root -g root "$TMP/nginx.conf" "$CONF"
      if [[ -f "$TMP/old-fullchain.pem" && -f "$TMP/old-privkey.pem" ]]; then
        install -m 0644 -o root -g root "$TMP/old-fullchain.pem" "$CERT_DIR/fullchain.pem"
        install -m 0600 -o root -g root "$TMP/old-privkey.pem" "$CERT_DIR/privkey.pem"
      else
        rm -rf "$CERT_DIR"
      fi
      die "nginx rejected the uploaded certificate configuration"
    fi
    systemctl reload nginx
    echo "custom certificate installed for $DOMAIN"
    ;;

  cert-custom-delete)
    DOMAIN="${1:-}"; valid_domain "$DOMAIN"
    CONF="$NGINX_AV/$DOMAIN"; CERT_DIR="/etc/nebula-panel/certs/$DOMAIN"
    if [[ -f "$CONF" ]]; then
      TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
      cp "$CONF" "$TMP"
      sed -i '/# NEBULA_CUSTOM_SSL_BEGIN/,/# NEBULA_CUSTOM_SSL_END/d' "$CONF"
      nginx -t >/dev/null 2>&1 || { cp "$TMP" "$CONF"; die "nginx config test failed"; }
      systemctl reload nginx
    fi
    rm -rf "$CERT_DIR"
    echo "custom certificate removed for $DOMAIN"
    ;;

  # php-ini <version> <key> <value>  (whitelisted keys; sets fpm+cli, reloads fpm)
  php-ini)
    VER="${1:-}"; KEY="${2:-}"; VAL="${3:-}"
    valid_php "$VER"
    case "$KEY" in
      memory_limit|upload_max_filesize|post_max_size|max_execution_time|max_input_time|max_input_vars|display_errors|log_errors|max_file_uploads|default_socket_timeout|opcache.enable|opcache.memory_consumption|opcache.max_accelerated_files|opcache.validate_timestamps|xdebug.mode|xdebug.client_port|xdebug.start_with_request) ;;
      *) die "ini key not allowed" ;;
    esac
    [[ "$VAL" =~ ^[A-Za-z0-9_.,-]+$ ]] || die "invalid value"
    KEY_RE="${KEY//./\\.}"
    changed=0
    for SAPI in fpm cli; do
      INI="/etc/php/${VER}/${SAPI}/php.ini"
      [[ -f "$INI" ]] || continue
      if grep -qE "^;?[[:space:]]*${KEY_RE}[[:space:]]*=" "$INI"; then
        sed -i -E "s|^;?[[:space:]]*(${KEY_RE})[[:space:]]*=.*|\1 = ${VAL}|" "$INI"
      else
        echo "${KEY} = ${VAL}" >> "$INI"
      fi
      changed=1
    done
    [[ "$changed" == 1 ]] || die "no php.ini found for ${VER}"
    # Do not reload the FPM pool synchronously: this helper is normally called
    # by that same pool, and tearing down its FastCGI request produces an Nginx
    # 502 even though the ini edit succeeded. Schedule the reload after the API
    # response has had time to reach the browser.
    schedule_php_service reload "$VER"
    echo "set ${KEY}=${VAL} for php ${VER}; reload scheduled"
    ;;

  # ==========================================================================
  # Mail stack — Postfix (MTA) + Dovecot (IMAP/POP3/LMTP + SASL) + OpenDKIM.
  #
  # Virtual, file-backed mailboxes (no SQL): all state lives under
  # /etc/nebula-mail and is regenerated wholesale by `mail-apply` from data the
  # panel owns, so there is never drift between the panel and the running MTA.
  # ==========================================================================
  mail-setup)
    exec 8>/run/lock/nebula-panel-mail.lock
    flock -w 30 8 || die "another mail operation is running"
    export DEBIAN_FRONTEND=noninteractive
    HOSTFQDN="${1:-}"
    CERT_EMAIL="${2:-}"
    valid_domain "$HOSTFQDN"
    valid_email "$CERT_EMAIL"
    command -v certbot >/dev/null 2>&1 || die "certbot is not installed; re-run install.sh first"
    command -v openssl >/dev/null 2>&1 || die "openssl is not installed"
    MAIL_CERT="/etc/letsencrypt/live/${HOSTFQDN}/fullchain.pem"
    MAIL_KEY="/etc/letsencrypt/live/${HOSTFQDN}/privkey.pem"
    mail_certificate_valid() {
      [[ -r "$MAIL_CERT" && -r "$MAIL_KEY" ]] \
        && openssl x509 -in "$MAIL_CERT" -noout -checkend 86400 >/dev/null 2>&1 \
        && openssl x509 -in "$MAIL_CERT" -noout -checkhost "$HOSTFQDN" >/dev/null 2>&1
    }
    if ! mail_certificate_valid; then
      echo "Requesting a Let's Encrypt certificate for ${HOSTFQDN}..."
      CERTBOT_ARGS=(certonly --nginx -d "$HOSTFQDN" --non-interactive --agree-tos)
      if [[ -n "$CERT_EMAIL" ]]; then
        CERTBOT_ARGS+=(-m "$CERT_EMAIL")
      else
        CERTBOT_ARGS+=(--register-unsafely-without-email)
      fi
      if ! certbot "${CERTBOT_ARGS[@]}"; then
        die "certificate request failed; point ${HOSTFQDN} DNS at this server and make ports 80 and 443 reachable, then retry"
      fi
      mail_certificate_valid \
        || die "Let's Encrypt did not produce a current certificate valid for ${HOSTFQDN}"
    fi
    echo "Installing mail packages (Postfix, Dovecot, OpenDKIM)…"
    echo "postfix postfix/main_mailer_type select Internet Site" | debconf-set-selections
    echo "postfix postfix/mailname string ${HOSTFQDN}" | debconf-set-selections
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 update
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y \
      postfix dovecot-core dovecot-imapd dovecot-pop3d dovecot-lmtpd \
      opendkim opendkim-tools ssl-cert || die "mail package installation failed"

    echo "Creating virtual mail user and directories…"
    getent group vmail >/dev/null 2>&1 || groupadd --system vmail
    getent passwd vmail >/dev/null 2>&1 || \
      useradd --system -g vmail -d "$MAIL_STORE" -s /usr/sbin/nologin vmail
    MAIL_VUID="$(id -u vmail)"
    MAIL_VGID="$(id -g vmail)"
    install -d -m 0700 -o vmail -g vmail "$MAIL_STORE"
    # 0755 so the dovecot user (auth-worker) and opendkim can TRAVERSE into the
    # directory to reach their files. The sensitive files inside keep their own
    # restrictive modes (dovecot-users 0640 root:dovecot, DKIM keys 0600), so a
    # searchable parent does not expose anything. A 0750 root:root parent was
    # the real cause of the passdb "temp_fail" — dovecot couldn't traverse it.
    install -d -m 0755 -o root -g root "$MAIL_DIR"
    chmod 0755 "$MAIL_DIR"
    install -d -m 0750 -o opendkim -g opendkim "$DKIM_DIR" 2>/dev/null || install -d -m 0750 "$DKIM_DIR"
    : > "$MAIL_DIR/vdomains"; : > "$MAIL_DIR/vmailbox"; : > "$MAIL_DIR/valias"
    : > "$MAIL_DIR/dovecot-users"
    # Must be readable by the 'dovecot' user (the auth-worker runs as it), or
    # every login fails with "Temporary authentication failure".
    if getent group dovecot >/dev/null 2>&1; then
      chown root:dovecot "$MAIL_DIR/dovecot-users"; chmod 0640 "$MAIL_DIR/dovecot-users"
    else
      die "dovecot group is missing; refusing to expose the password database"
    fi
    postmap "$MAIL_DIR/vdomains" "$MAIL_DIR/vmailbox" "$MAIL_DIR/valias"

    echo "Configuring Postfix…"
    postconf -e "myhostname = ${HOSTFQDN}"
    postconf -e "inet_interfaces = all"
    postconf -e "inet_protocols = all"
    postconf -e "smtpd_banner = \$myhostname ESMTP"
    postconf -e "virtual_mailbox_domains = hash:$MAIL_DIR/vdomains"
    postconf -e "virtual_mailbox_base = $MAIL_STORE"
    postconf -e "virtual_mailbox_maps = hash:$MAIL_DIR/vmailbox"
    postconf -e "virtual_alias_maps = hash:$MAIL_DIR/valias"
    postconf -e "virtual_minimum_uid = $MAIL_VUID"
    postconf -e "virtual_uid_maps = static:$MAIL_VUID"
    postconf -e "virtual_gid_maps = static:$MAIL_VGID"
    postconf -e "virtual_transport = lmtp:unix:private/dovecot-lmtp"
    postconf -e "smtpd_sasl_type = dovecot"
    postconf -e "smtpd_sasl_path = private/auth"
    postconf -e "smtpd_tls_security_level = may"
    postconf -e "smtpd_tls_cert_file = $MAIL_CERT"
    postconf -e "smtpd_tls_key_file = $MAIL_KEY"
    postconf -e "smtpd_tls_protocols = >=TLSv1.2"
    postconf -e "smtpd_tls_mandatory_protocols = >=TLSv1.2"
    postconf -e "smtp_tls_security_level = may"
    postconf -e "milter_default_action = accept"
    postconf -e "milter_protocol = 6"
    # Pin the milter to IPv4 on both sides. With "localhost", Postfix and
    # OpenDKIM can resolve to different stacks (127.0.0.1 vs ::1) and miss each
    # other — that is the "connect to Milter service ... Connection refused".
    postconf -e "smtpd_milters = inet:127.0.0.1:8891"
    postconf -e "non_smtpd_milters = inet:127.0.0.1:8891"
    # Submission (587) with SASL for authenticated mail clients.
    postconf -M submission/inet="submission inet n - y - - smtpd"
    postconf -P "submission/inet/syslog_name=postfix/submission"
    postconf -P "submission/inet/smtpd_tls_security_level=encrypt"
    postconf -P "submission/inet/smtpd_sasl_auth_enable=yes"
    postconf -P "submission/inet/smtpd_sasl_type=dovecot"
    postconf -P "submission/inet/smtpd_sasl_path=private/auth"
    postconf -P "submission/inet/smtpd_reject_unlisted_recipient=no"
    postconf -P "submission/inet/smtpd_relay_restrictions=permit_sasl_authenticated,reject"
    postconf -P "submission/inet/milter_macro_daemon_name=ORIGINATING"

    echo "Configuring Dovecot…"
    # Disable the distro's *system* auth (PAM/passwd) so our virtual passwd-file
    # is the sole, authoritative source. Leaving system auth enabled adds a
    # competing passdb/userdb that can shadow virtual mailboxes and break login.
    if [[ -f /etc/dovecot/conf.d/10-auth.conf ]]; then
      sed -i -E 's|^[[:space:]]*!include auth-system\.conf\.ext|#!include auth-system.conf.ext|' \
        /etc/dovecot/conf.d/10-auth.conf
    fi
    cat > /etc/dovecot/conf.d/99-nebula.conf <<EOF
# Managed by Nebula Panel — do not edit by hand.
protocols = imap pop3 lmtp
mail_location = maildir:$MAIL_STORE/%d/%n
mail_uid = vmail
mail_gid = vmail
first_valid_uid = $MAIL_VUID
last_valid_uid = $MAIL_VUID
disable_plaintext_auth = yes
auth_mechanisms = plain login
passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format=%u $MAIL_DIR/dovecot-users
}
userdb {
  driver = static
  args = uid=vmail gid=vmail home=$MAIL_STORE/%d/%n
}
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
    user = vmail
  }
}
ssl = required
ssl_min_protocol = TLSv1.2
ssl_cert = <$MAIL_CERT
ssl_key = <$MAIL_KEY
EOF

    echo "Configuring OpenDKIM…"
    install -d -m 0755 /run/opendkim -o opendkim -g opendkim 2>/dev/null || true
    printf '127.0.0.1\nlocalhost\n::1\n' > "$DKIM_DIR/TrustedHosts"
    touch "$DKIM_DIR/KeyTable" "$DKIM_DIR/SigningTable"
    cat > /etc/opendkim.conf <<EOF
# Managed by Nebula Panel — do not edit by hand.
Syslog                  yes
UMask                   002
Mode                    sv
SubDomains              no
AutoRestart             yes
AutoRestartRate         10/1h
Canonicalization        relaxed/simple
OversignHeaders         From
Socket                  inet:8891@127.0.0.1
PidFile                 /run/opendkim/opendkim.pid
UserID                  opendkim
KeyTable                $DKIM_DIR/KeyTable
SigningTable            refile:$DKIM_DIR/SigningTable
ExternalIgnoreList      $DKIM_DIR/TrustedHosts
InternalHosts           $DKIM_DIR/TrustedHosts
EOF
    if [[ -f /etc/default/opendkim ]]; then
      sed -i 's|^SOCKET=.*|SOCKET="inet:8891@127.0.0.1"|' /etc/default/opendkim
      grep -q '^SOCKET=' /etc/default/opendkim || echo 'SOCKET="inet:8891@127.0.0.1"' >> /etc/default/opendkim
    fi
    chown -R opendkim:opendkim "$DKIM_DIR" 2>/dev/null || true

    systemctl enable --now opendkim >/dev/null 2>&1 || systemctl restart opendkim || true
    systemctl restart dovecot || die "dovecot failed to start"
    systemctl restart postfix || die "postfix failed to start"
    systemctl enable dovecot postfix >/dev/null 2>&1 || true

    # Open the standard mail ports when UFW is active so delivery works.
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
      for P in 25 587 993 995; do ufw allow "${P}/tcp" >/dev/null 2>&1 || true; done
      echo "opened mail ports in UFW"
    fi
    echo "mail stack ready"
    ;;

  # mail-status  ->  key=value status lines parsed by the panel.
  mail-status)
    svc() { systemctl is-active "$1" 2>/dev/null || echo inactive; }
    INSTALLED=no
    [[ -d "$MAIL_DIR" ]] && command -v postfix >/dev/null 2>&1 && command -v dovecot >/dev/null 2>&1 && INSTALLED=yes
    IP="$([[ -r "$PUBLIC_IP_FILE" ]] && head -n 1 "$PUBLIC_IP_FILE" || true)"
    echo "installed=$INSTALLED"
    echo "postfix=$(svc postfix)"
    echo "dovecot=$(svc dovecot)"
    echo "opendkim=$(svc opendkim)"
    HOSTFQDN="$(postconf -h myhostname 2>/dev/null || true)"
    [[ -n "$HOSTFQDN" ]] || HOSTFQDN="$(hostname -f 2>/dev/null || hostname)"
    echo "hostname=$HOSTFQDN"
    echo "ip=${IP:-}"
    ;;

  # mail-diag  ->  human-readable diagnostics for login/auth failures. Surfaces
  # the real reason behind Dovecot's opaque "Temporary authentication failure".
  mail-diag)
    echo "== services =="
    for s in postfix dovecot opendkim; do
      printf '%-9s %s\n' "$s:" "$(systemctl is-active "$s" 2>/dev/null || echo inactive)"
    done
    echo
    echo "== passdb (dovecot-users) =="
    if [[ -f "$MAIL_DIR/dovecot-users" ]]; then
      ls -l "$MAIL_DIR/dovecot-users"
      echo "mailboxes: $(grep -c ':' "$MAIL_DIR/dovecot-users" 2>/dev/null || echo 0)"
      # The passdb lookup runs in Dovecot's auth-worker as the 'dovecot' user;
      # if it can't read this file every login fails with a temporary error.
      if id dovecot >/dev/null 2>&1; then
        if sudo -u dovecot test -r "$MAIL_DIR/dovecot-users" 2>/dev/null; then
          echo "readable by dovecot user: yes"
        else
          echo "readable by dovecot user: NO  <-- causes 'Temporary authentication failure'"
        fi
      fi
    else
      echo "MISSING: $MAIL_DIR/dovecot-users  (install the mail stack and add a mailbox)"
    fi
    echo
    echo "== dovecot config =="
    if command -v doveconf >/dev/null 2>&1; then
      if doveconf -n >/dev/null 2>&1; then echo "doveconf: OK"; else echo "doveconf: ERRORS"; doveconf -n 2>&1 | grep -i error | head -n 5; fi
    fi
    echo
    echo "== userdb/passdb resolution =="
    if command -v doveadm >/dev/null 2>&1 && [[ -f "$MAIL_DIR/dovecot-users" ]]; then
      while IFS=: read -r email _; do
        [[ -z "$email" ]] && continue
        echo "-- $email"
        doveadm user "$email" 2>&1 | sed -n '1,6p'
      done < <(head -n 10 "$MAIL_DIR/dovecot-users" 2>/dev/null)
    fi
    echo
    echo "== mail flow (send/receive) =="
    echo "-- postfix routing"
    postconf myhostname mydestination virtual_mailbox_domains virtual_mailbox_maps virtual_transport relayhost inet_interfaces smtpd_milters 2>/dev/null
    echo
    echo "-- milter socket (expect 127.0.0.1:8891 LISTEN)"
    ss -ltn 2>/dev/null | grep -E ':8891' || echo "NOT LISTENING on 8891  <-- OpenDKIM milter down; mail is unsigned"
    echo
    echo "-- outbound port 25 (cloud providers often block this, breaking SENDING)"
    if timeout 6 bash -c 'exec 3<>/dev/tcp/gmail-smtp-in.l.google.com/25' 2>/dev/null; then
      echo "outbound 25: OPEN (can reach remote mail servers)"
    else
      echo "outbound 25: BLOCKED or unreachable  <-- outbound mail will queue and fail; ask your host to unblock port 25 or use a smarthost/relay"
    fi
    echo
    echo "-- DNS for mail domains (needed to RECEIVE)"
    IP="$([[ -r "$PUBLIC_IP_FILE" ]] && head -n 1 "$PUBLIC_IP_FILE" || true)"
    echo "this server public IP: ${IP:-unknown}"
    if [[ -f "$MAIL_DIR/vdomains" ]] && command -v dig >/dev/null 2>&1; then
      while read -r d _ || [[ -n "$d" ]]; do
        [[ -z "$d" ]] && continue
        mx="$(dig +short MX "$d" 2>/dev/null | tr '\n' ' ')"
        a="$(dig +short A "mail.$d" 2>/dev/null | tr '\n' ' ')"
        echo "  $d  MX: ${mx:-<none set>}   mail.$d A: ${a:-<none>}"
      done < "$MAIL_DIR/vdomains"
    fi
    echo
    echo "-- mail queue (stuck outbound mail + reason)"
    mailq 2>/dev/null | tail -n 12
    echo
    echo "== recent mail log =="
    { journalctl -u postfix -u dovecot -u opendkim -n 140 --no-pager 2>/dev/null; tail -n 250 /var/log/mail.log 2>/dev/null; } \
      | grep -iE 'auth|login|error|warning|passwd|userdb|reject|status=|relay=|milter|bounce|deferred|connect to|lmtp' | tail -n 35
    ;;

  # mail-stats [days]  ->  raw material for the panel's email statistics tab:
  #   header key=value lines, one `mailbox` row per maildir, then the filtered
  #   Postfix/Dovecot log lines the panel aggregates. Reading mail logs and
  #   maildirs needs root, so the parsing happens panel-side on this output.
  mail-stats)
    DAYS="${1:-30}"
    [[ "$DAYS" =~ ^[0-9]{1,3}$ ]] || die "invalid day count"
    [[ "$DAYS" -ge 1 ]] || DAYS=1
    echo "days=$DAYS"
    echo "now=$(date '+%Y-%m-%d %H:%M:%S')"

    # Queue depth per state (what is stuck, and where).
    if command -v postqueue >/dev/null 2>&1; then
      Q="$(postqueue -p 2>/dev/null || true)"
      echo "queue_total=$(printf '%s' "$Q" | grep -cE '^[0-9A-F]{8,}' || true)"
      echo "queue_deferred=$(printf '%s' "$Q" | grep -cE '^[0-9A-F]{8,}\*?!' || true)"
    else
      echo "queue_total=0"; echo "queue_deferred=0"
    fi

    # Per-mailbox size and message counts straight off the maildirs.
    if [[ -d "$MAIL_STORE" ]]; then
      for DDIR in "$MAIL_STORE"/*/; do
        [[ -d "$DDIR" ]] || continue
        DOM="$(basename "$DDIR")"
        for UDIR in "$DDIR"*/; do
          [[ -d "$UDIR" ]] || continue
          USR="$(basename "$UDIR")"
          BYTES="$(du -sb "$UDIR" 2>/dev/null | awk '{print $1}')"
          CUR="$(find "$UDIR/cur" -type f 2>/dev/null | wc -l)"
          NEW="$(find "$UDIR/new" -type f 2>/dev/null | wc -l)"
          printf 'mailbox\t%s@%s\t%s\t%s\t%s\n' "$USR" "$DOM" "${BYTES:-0}" "$((CUR + NEW))" "$NEW"
        done
      done
    fi

    # One log source only — mixing rsyslog and journald double-counts events.
    FILTER='status=(sent|bounced|deferred|expired)|from=<|NOQUEUE: reject|reject: RCPT|imap-login: Login|pop3-login: Login|auth failed|authentication failure|Aborted login'
    if [[ -r /var/log/mail.log ]]; then
      echo "source=/var/log/mail.log"
      echo "== log =="
      { [[ -r /var/log/mail.log.1 ]] && cat /var/log/mail.log.1; cat /var/log/mail.log; } 2>/dev/null \
        | grep -aE "$FILTER" | tail -n 20000 || true
    else
      echo "source=journal"
      echo "== log =="
      journalctl -u postfix -u dovecot --since "${DAYS} days ago" --no-pager -o short 2>/dev/null \
        | grep -aE "$FILTER" | tail -n 20000 || true
    fi
    ;;

  # mail-apply <domains_b64> <accounts_b64> <aliases_b64>
  #   domains_b64  : newline list of mail domains
  #   accounts_b64 : newline of  email<TAB>{SHA512-CRYPT}$6$hash
  #   aliases_b64  : newline of  alias@domain<TAB>destination@domain
  # Rebuilds every map from scratch, ensures DKIM keys + maildirs, reloads.
  mail-apply)
    [[ -d "$MAIL_DIR" ]] || die "mail stack is not installed; run mail-setup first"
    exec 8>/run/lock/nebula-panel-mail.lock
    flock -w 30 8 || die "another mail operation is running"
    DOMAINS_B64="${1:-}"; ACCOUNTS_B64="${2:-}"; ALIASES_B64="${3:-}"
    for v in "$DOMAINS_B64" "$ACCOUNTS_B64" "$ALIASES_B64"; do
      [[ -z "$v" || "$v" =~ ^[A-Za-z0-9+/=]+$ ]] || die "invalid input encoding"
    done
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    printf '%s' "$DOMAINS_B64"  | base64 -d > "$TMP/domains"  2>/dev/null || die "invalid domain-map encoding"
    printf '%s' "$ACCOUNTS_B64" | base64 -d > "$TMP/accounts" 2>/dev/null || die "invalid account-map encoding"
    printf '%s' "$ALIASES_B64"  | base64 -d > "$TMP/aliases"  2>/dev/null || die "invalid alias-map encoding"

    : > "$TMP/vdomains"; : > "$TMP/vmailbox"; : > "$TMP/valias"; : > "$TMP/dovecot-users"
    # Skip malformed rows rather than aborting: a single bad entry must never
    # take down the whole mail configuration (which would break login for every
    # otherwise-valid mailbox). Rejected rows are reported on stderr.
    # NOTE the `|| [[ -n "$x" ]]` on every loop: the decoded input has no
    # trailing newline, so a plain `while read` silently drops the FINAL line.
    # With a single domain/mailbox that is the only line — which is why one
    # mailbox never reached Dovecot and every login failed as "unknown user".
    declare -A KNOWN_DOMAIN=()
    while IFS= read -r d || [[ -n "$d" ]]; do
      [[ -z "$d" ]] && continue
      if [[ ! "$d" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]{0,251}[a-zA-Z0-9])?$ ]]; then
        echo "skipping invalid mail domain: $d" >&2; continue
      fi
      KNOWN_DOMAIN["$d"]=1
      printf '%s OK\n' "$d" >> "$TMP/vdomains"
    done < "$TMP/domains"

    while IFS=$'\t' read -r email hash || [[ -n "$email" ]]; do
      [[ -z "$email" ]] && continue
      if [[ ! "$email" =~ ^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+$ ]]; then
        echo "skipping invalid account address: $email" >&2; continue
      fi
      if [[ ! "$hash" =~ ^\{SHA512-CRYPT\}\$6\$[./A-Za-z0-9]{1,32}\$[./A-Za-z0-9]{1,200}$ ]]; then
        echo "skipping account with invalid password hash: $email" >&2; continue
      fi
      local_part="${email%@*}"; domain_part="${email#*@}"
      if [[ -z "${KNOWN_DOMAIN[$domain_part]:-}" ]]; then
        echo "skipping account whose domain is not in the domain list: $email" >&2; continue
      fi
      if [[ ! "$local_part" =~ ^[a-zA-Z0-9._%+-]+$ ]]; then
        echo "skipping account with invalid local part: $email" >&2; continue
      fi
      printf '%s %s/%s/\n' "$email" "$domain_part" "$local_part" >> "$TMP/vmailbox"
      printf '%s:%s:%s:%s::%s/%s/%s::\n' "$email" "$hash" "$MAIL_VUID" "$MAIL_VGID" "$MAIL_STORE" "$domain_part" "$local_part" >> "$TMP/dovecot-users"
    done < "$TMP/accounts"

    while IFS=$'\t' read -r from to || [[ -n "$from" ]]; do
      [[ -z "$from" ]] && continue
      if [[ ! "$from" =~ ^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+$ ]]; then
        echo "skipping invalid alias address: $from" >&2; continue
      fi
      if [[ ! "$to" =~ ^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+$ ]]; then
        echo "skipping invalid alias destination: $to" >&2; continue
      fi
      printf '%s %s\n' "$from" "$to" >> "$TMP/valias"
    done < "$TMP/aliases"

    # Build hashed maps while everything is still staged.
    postmap "$TMP/vdomains" "$TMP/vmailbox" "$TMP/valias" \
      || die "Postfix rejected the staged maps"

    # Keep a restorable copy of the last known-good live maps. This turns a
    # failed validation/reload into a real rollback instead of state drift.
    LIVE_FILES=(
      "$MAIL_DIR/vdomains" "$MAIL_DIR/vdomains.db"
      "$MAIL_DIR/vmailbox" "$MAIL_DIR/vmailbox.db"
      "$MAIL_DIR/valias" "$MAIL_DIR/valias.db"
      "$MAIL_DIR/dovecot-users" "$DKIM_DIR/KeyTable" "$DKIM_DIR/SigningTable"
    )
    install -d -m 0700 "$TMP/previous"
    for i in "${!LIVE_FILES[@]}"; do
      path="${LIVE_FILES[$i]}"
      if [[ -e "$path" ]]; then cp -a "$path" "$TMP/previous/$i"; else : > "$TMP/previous/$i.missing"; fi
    done
    rollback_mail_maps() {
      local j path
      for j in "${!LIVE_FILES[@]}"; do
        path="${LIVE_FILES[$j]}"
        if [[ -f "$TMP/previous/$j.missing" ]]; then rm -f -- "$path"; else cp -a "$TMP/previous/$j" "$path"; fi
      done
      systemctl reload opendkim >/dev/null 2>&1 || true
      systemctl reload postfix >/dev/null 2>&1 || true
      systemctl reload dovecot >/dev/null 2>&1 || true
    }

    # Install the regenerated maps atomically.
    install -m 0644 -o root -g root "$TMP/vdomains" "$MAIL_DIR/vdomains"
    install -m 0644 -o root -g root "$TMP/vdomains.db" "$MAIL_DIR/vdomains.db"
    install -m 0644 -o root -g root "$TMP/vmailbox" "$MAIL_DIR/vmailbox"
    install -m 0644 -o root -g root "$TMP/vmailbox.db" "$MAIL_DIR/vmailbox.db"
    install -m 0644 -o root -g root "$TMP/valias"   "$MAIL_DIR/valias"
    install -m 0644 -o root -g root "$TMP/valias.db" "$MAIL_DIR/valias.db"
    # Readable by the 'dovecot' user (auth-worker) — see mail-setup note.
    if getent group dovecot >/dev/null 2>&1; then
      install -m 0640 -o root -g dovecot "$TMP/dovecot-users" "$MAIL_DIR/dovecot-users"
    else
      rollback_mail_maps
      die "dovecot group is missing; refusing to expose mailbox hashes"
    fi

    # Ensure a Maildir exists for every mailbox (Dovecot also autocreates).
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      sub="${line#* }"
      install -d -m 0700 -o vmail -g vmail "$MAIL_STORE/${sub%/}" \
        "$MAIL_STORE/${sub%/}/cur" "$MAIL_STORE/${sub%/}/new" "$MAIL_STORE/${sub%/}/tmp"
    done < "$MAIL_DIR/vmailbox"

    # Rebuild DKIM key tables from the domain list, generating any missing keys.
    : > "$TMP/KeyTable"; : > "$TMP/SigningTable"
    for d in "${!KNOWN_DOMAIN[@]}"; do
      KDIR="$DKIM_DIR/$d"
      if [[ ! -f "$KDIR/mail.private" ]]; then
        install -d -m 0750 "$KDIR"
        # Best-effort: a DKIM hiccup must not abort applying mailboxes/aliases
        # (which would otherwise break login). Domains without a key simply have
        # no DKIM signing until the key can be generated.
        if ! opendkim-genkey -b 2048 -d "$d" -D "$KDIR" -s mail >/dev/null 2>&1; then
          echo "warning: DKIM key generation failed for $d — signing disabled for it" >&2
          continue
        fi
        chown -R opendkim:opendkim "$KDIR" 2>/dev/null || true
        chmod 0600 "$KDIR/mail.private" 2>/dev/null || true
      fi
      [[ -f "$KDIR/mail.private" ]] || continue
      printf 'mail._domainkey.%s %s:mail:%s/mail.private\n' "$d" "$d" "$KDIR" >> "$TMP/KeyTable"
      printf '*@%s mail._domainkey.%s\n' "$d" "$d" >> "$TMP/SigningTable"
    done
    install -m 0644 "$TMP/KeyTable"    "$DKIM_DIR/KeyTable"
    install -m 0644 "$TMP/SigningTable" "$DKIM_DIR/SigningTable"
    chown -R opendkim:opendkim "$DKIM_DIR" 2>/dev/null || true

    if ! postfix check || ! doveconf -n >/dev/null; then
      rollback_mail_maps
      die "mail configuration validation failed; previous maps restored"
    fi
    if ! (systemctl reload opendkim 2>/dev/null || systemctl restart opendkim 2>/dev/null) \
      || ! (systemctl reload postfix 2>/dev/null || systemctl restart postfix 2>/dev/null) \
      || ! (systemctl reload dovecot 2>/dev/null || systemctl restart dovecot 2>/dev/null); then
      rollback_mail_maps
      die "mail service reload failed; previous maps restored"
    fi
    echo "mail configuration applied"
    ;;

  # mail-dkim <domain>  ->  selector=..  value=..  (the public TXT record body)
  mail-dkim)
    DOMAIN="${1:-}"; valid_domain "$DOMAIN"
    KDIR="$DKIM_DIR/$DOMAIN"
    TXT="$KDIR/mail.txt"
    # Generate the key on demand if it is missing, so the panel's DNS tab can
    # always show a DKIM record once the mail stack is installed. (mail-apply
    # normally creates it, but a domain added before the stack — or a failed
    # earlier generation — can leave it absent.)
    if [[ ! -f "$TXT" ]] && command -v opendkim-genkey >/dev/null 2>&1; then
      install -d -m 0750 "$KDIR" 2>/dev/null || true
      if opendkim-genkey -b 2048 -d "$DOMAIN" -D "$KDIR" -s mail >/dev/null 2>&1; then
        chown -R opendkim:opendkim "$KDIR" 2>/dev/null || true
        chmod 0600 "$KDIR/mail.private" 2>/dev/null || true
      fi
    fi
    [[ -f "$TXT" ]] || die "no DKIM key for $DOMAIN; install the mail stack, then add the domain"
    # opendkim-genkey writes the record split across quoted strings; join them
    # back into one continuous value the panel can present and publish.
    VALUE="$(grep -o '"[^"]*"' "$TXT" | sed 's/^"//; s/"$//' | tr -d '\n' | tr -d ' \t')"
    [[ -n "$VALUE" ]] || die "could not read DKIM public key"
    echo "selector=mail"
    echo "value=$VALUE"
    ;;

  # roundcube-install <targetdir>
  roundcube-install)
    TARGET="${1:-}"; valid_path "$TARGET"
    HOSTFQDN="$(postconf -h myhostname 2>/dev/null || true)"
    [[ -n "$HOSTFQDN" ]] || die "mail hostname is not configured; install or repair the mail stack first"
    [[ -r "/etc/letsencrypt/live/${HOSTFQDN}/fullchain.pem" ]] \
      || die "mail hostname certificate is missing"
    export DEBIAN_FRONTEND=noninteractive
    # Roundcube's runtime dependencies (SQLite backend keeps setup zero-config).
    PHP_VER="$(ls -d /etc/php/*/fpm 2>/dev/null | sort -V | tail -1 | awk -F/ '{print $4}')"
    if [[ -n "$PHP_VER" ]]; then
      apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y \
        "php${PHP_VER}-sqlite3" "php${PHP_VER}-intl" "php${PHP_VER}-xml" \
        "php${PHP_VER}-mbstring" "php${PHP_VER}-zip" "php${PHP_VER}-gd" \
        "php${PHP_VER}-curl" "php${PHP_VER}-imagick" >/dev/null 2>&1 || true
    fi
    apt-get -o Dpkg::Use-Pty=0 -o APT::Color=0 install -y roundcube-core roundcube-sqlite3 \
      || die "distribution-verified Roundcube package install failed"
    SRC=/usr/share/roundcube
    [[ -f "$SRC/index.php" ]] || die "Roundcube package layout unexpected"
    mkdir -p "$TARGET"; cp -aL "$SRC"/. "$TARGET"/
    rm -rf "$TARGET/installer"
    install -d -m 0750 -o nebula-webapps -g nebula-webapps /var/lib/nebula-mail
    DESKEY="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
    cat > "$TARGET/config/config.inc.php" <<EOF
<?php
/* Managed by Nebula Panel. */
\$config = [];
\$config['db_dsnw'] = 'sqlite:////var/lib/nebula-mail/roundcube.db?mode=0640';
    \$config['imap_host'] = 'ssl://${HOSTFQDN}:993';
    \$config['smtp_host'] = 'tls://${HOSTFQDN}:587';
\$config['smtp_user'] = '%u';
\$config['smtp_pass'] = '%p';
    \$config['imap_conn_options'] = ['ssl' => ['verify_peer' => true, 'verify_peer_name' => true]];
    \$config['smtp_conn_options'] = ['ssl' => ['verify_peer' => true, 'verify_peer_name' => true]];
\$config['support_url'] = '';
\$config['product_name'] = 'Nebula Webmail';
\$config['des_key'] = '${DESKEY:0:24}';
\$config['plugins'] = ['archive', 'zipdownload', 'managesieve'];
\$config['skin'] = 'elastic';
\$config['enable_installer'] = false;
\$config['log_dir'] = '/var/lib/nebula-mail/rc-logs/';
\$config['temp_dir'] = '/var/lib/nebula-mail/rc-temp/';
EOF
    install -d -m 0750 -o nebula-webapps -g nebula-webapps /var/lib/nebula-mail/rc-logs /var/lib/nebula-mail/rc-temp
    chown -R nebula-webapps:nebula-webapps "$TARGET"
    echo "roundcube installed at $TARGET"
    ;;

  # roundcube-remove <targetdir>
  roundcube-remove)
    TARGET="${1:-}"; valid_path "$TARGET"
    [[ "$TARGET" == "/" || "$TARGET" == "/var/www" ]] && die "refusing"
    [[ -f "$TARGET/config/config.inc.php" ]] || die "not a roundcube dir"
    rm -rf "$TARGET"
    echo "removed $TARGET"
    ;;

  # webmail-remove <targetdir>  — generic removal for any panel-managed webmail
  # directory (Roundcube or SnappyMail). Confined by the managed naming scheme.
  webmail-remove)
    TARGET="${1:-}"; valid_path "$TARGET"
    base="$(basename "$TARGET")"
    [[ "$base" =~ ^(webmail|snappymail)-[0-9a-fA-F]+$ ]] || die "not a managed webmail dir"
    [[ -f "$TARGET/index.php" ]] || die "not a webmail dir"
    rm -rf "$TARGET"
    echo "removed $TARGET"
    ;;

  *)
    die "unknown command: $CMD"
    ;;
esac
